# GitHub token used to read each repo's changelog/ and context-v/ when a page
# is requested. Needed in Vercel and for `pnpm dev`.
#
# Anonymous requests get 60 calls an hour and a fresh server instance needs
# about 30, so a token is effectively required. It only needs read access to
# public repositories. GITHUB_TOKEN works too.

GITHUB_API_TOKEN=

# OpenPanel — public clientId for analytics (visible in HTML by design).
# Provisioned at https://openpanel.dev → site settings.
# Used by src/components/Analytics.astro; gated on import.meta.env.PROD.
# Read at build time, so set it in the Vercel project too.
OPENPANEL_CLIENT_ID=
