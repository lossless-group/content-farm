# GitHub token used to read each repo's changelog/ and context-v/ at build time.
# Optional for a local `pnpm dev` or `pnpm build`. GitHub Actions passes its own
# GITHUB_TOKEN. It only needs read access to public repositories.

GITHUB_API_TOKEN=

# OpenPanel — public clientId for analytics (visible in HTML by design).
# Provisioned at https://openpanel.dev → site settings.
# Used by src/components/Analytics.astro; gated on import.meta.env.PROD.
OPENPANEL_CLIENT_ID=
