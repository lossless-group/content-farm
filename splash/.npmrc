# JSR registry — required to resolve @jsr/* aliased deps like
# @lossless-group/lfm (published at jsr.io/@lossless-group/lfm and consumed
# via the npm alias `npm:@jsr/lossless-group__lfm@…` in package.json).
# Public registry, no auth token needed.
@jsr:registry=https://npm.jsr.io

# Don't inherit the parent monorepo's pnpm workspace — both content-farm and
# lossless-monorepo declare pnpm-workspace.yaml files that, if respected here,
# divert install resolution and silently skip new dependencies. Splash is a
# self-contained Astro app; resolve from its own package.json only.
ignore-workspace=true
