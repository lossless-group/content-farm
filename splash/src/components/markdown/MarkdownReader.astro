---
/* MarkdownReader
   Generic LFM-rendered reading column. Used by /projects/[slug]/ and
   /working-groups/[slug]/ (and any future detail page that wants the same
   prose treatment). Wraps an MDAST tree in a 70ch column with prose styling.
   Top chrome: optional back-link + optional "Edit on source" link.
   Renders Sources at the bottom when citations are non-empty. */

import AstroMarkdown from './AstroMarkdown.astro';
import Sources from './Sources.astro';

export interface Props {
  tree: any;                  // MDAST root from parseMarkdown()
  citations?: any[];          // tree.data.citations.ordered
  editUrl?: string;
  backHref?: string;          // default: '/projects/'
  backLabelTxt?: string;      // default: 'All projects'
}

const {
  tree,
  citations = [],
  editUrl,
  backHref = '/projects/',
  backLabelTxt = 'All projects',
} = Astro.props;
---

<article class="preader">
  <div class="preader__chrome">
    <a class="preader__back" href={backHref}>
      <span aria-hidden="true">←</span> {backLabelTxt}
    </a>
    {editUrl && (
      <a class="preader__edit" href={editUrl} target="_blank" rel="noopener noreferrer">
        Edit on source <span aria-hidden="true">↗</span>
      </a>
    )}
  </div>

  <div class="preader__prose">
    <AstroMarkdown node={tree} />
  </div>

  {citations.length > 0 && (
    <div class="preader__sources">
      <Sources citations={citations} />
    </div>
  )}
</article>

<style>
  .preader {
    max-width: 70ch;
    margin: 0 auto;
    padding: 2rem 1.5rem 4rem;
  }
  .preader__chrome {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 2rem;
    font-family: var(--ff-mono);
    font-size: 0.8125rem;
  }
  .preader__back,
  .preader__edit {
    color: var(--clr-text-soft);
    text-decoration: none;
    transition: color 150ms ease;
  }
  .preader__back:hover,
  .preader__edit:hover { color: var(--clr-cyan); }

  .preader__prose {
    color: var(--clr-text);
    font-family: var(--ff-sans);
    font-size: 1.0625rem;
    line-height: 1.75;
  }
  .preader__prose :global(h2) {
    font-family: var(--ff-sans);
    font-size: 1.5rem;
    font-weight: 700;
    color: var(--clr-text);
    margin-top: 2.5rem;
    margin-bottom: 0.75rem;
    letter-spacing: -0.01em;
  }
  .preader__prose :global(h3) {
    font-family: var(--ff-sans);
    font-size: 1.1875rem;
    font-weight: 600;
    color: var(--clr-text);
    margin-top: 1.75rem;
    margin-bottom: 0.5rem;
  }
  .preader__prose :global(p) {
    margin: 0 0 1.125rem;
  }
  .preader__prose :global(a) {
    color: var(--clr-cyan);
    text-decoration: underline;
    text-underline-offset: 0.18em;
  }
  .preader__prose :global(ul),
  .preader__prose :global(ol) {
    margin: 0 0 1.25rem;
    padding-left: 1.4rem;
  }
  .preader__prose :global(ul) { list-style: disc; }
  .preader__prose :global(ol) { list-style: decimal; }
  .preader__prose :global(li) { margin-bottom: 0.4rem; }
  .preader__prose :global(code) {
    font-family: var(--ff-mono);
    font-size: 0.92em;
    padding: 0.1em 0.35em;
    border-radius: 0.25rem;
    background: var(--clr-bg-soft);
    border: 1px solid var(--clr-border);
    color: var(--clr-cyan);
  }
  .preader__prose :global(strong) { color: var(--clr-text); }
  .preader__prose :global(em) { color: var(--clr-text); }
  .preader__prose :global(blockquote) {
    margin: 1.5rem 0;
    padding: 0.875rem 1.125rem;
    border-left: 3px solid var(--clr-cyan);
    background: var(--clr-bg-soft);
    color: var(--clr-text);
    font-style: italic;
  }
  .preader__prose :global(hr) {
    border: none;
    border-top: 1px solid var(--clr-border);
    margin: 2rem 0;
  }

  /* Headings beyond h2/h3 — h1 rare in body (title comes from frontmatter)
     but support it; h4 used for sub-sub-sections in long entries. */
  .preader__prose :global(h1) {
    font-family: var(--ff-sans);
    font-size: 1.875rem;
    font-weight: 700;
    color: var(--clr-text);
    margin-top: 2.5rem;
    margin-bottom: 0.75rem;
    letter-spacing: -0.02em;
  }
  .preader__prose :global(h4) {
    font-family: var(--ff-sans);
    font-size: 1.0625rem;
    font-weight: 600;
    color: var(--clr-text);
    margin-top: 1.5rem;
    margin-bottom: 0.5rem;
  }

  /* Tables — the 2026-05-18 family changelog has six of them; GFM tables
     come through structurally correct but un-styled by default. Treatment:
     dim card background, soft borders, sticky-ish thead, mono in cells. */
  .preader__prose :global(table) {
    width: 100%;
    margin: 1.5rem 0;
    border-collapse: collapse;
    background: var(--clr-bg-soft);
    border: 1px solid var(--clr-border);
    border-radius: var(--radius-sm);
    overflow: hidden;
    font-size: 0.9375rem;
  }
  .preader__prose :global(thead) {
    background: var(--clr-bg-elevated);
  }
  .preader__prose :global(th) {
    text-align: left;
    padding: 0.65rem 0.9rem;
    font-weight: 600;
    color: var(--clr-text);
    border-bottom: 1px solid var(--clr-border-strong);
    font-size: 0.85rem;
    letter-spacing: 0.01em;
  }
  .preader__prose :global(td) {
    padding: 0.65rem 0.9rem;
    border-top: 1px solid var(--clr-border);
    color: var(--clr-text-soft);
    vertical-align: top;
  }
  .preader__prose :global(tbody tr:hover) {
    background: rgba(255, 255, 255, 0.025);
  }
  .preader__prose :global(td code),
  .preader__prose :global(th code) {
    font-size: 0.85em;
  }

  /* Anchor-TOC pattern: the inline `<a href="#section-id">` links at the top
     of long entries (per the marketing-doctrine "TOC for long files" rule).
     Headings get id attributes from LFM automatically; this just makes the
     links look like nav links rather than body links. */
  .preader__prose :global(h2) {
    scroll-margin-top: 2rem;
  }
  .preader__prose :global(h3),
  .preader__prose :global(h4) {
    scroll-margin-top: 2rem;
  }

  .preader__sources {
    margin-top: 3rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--clr-border);
  }
</style>
