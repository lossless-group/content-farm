---
/**
 * MetaTags — comprehensive <head> metadata for a single page.
 *
 * Emits, in order:
 *   - <title>
 *   - <meta name="description">
 *   - <meta name="robots">
 *   - <link rel="canonical">
 *   - OpenGraph: og:type, og:site_name, og:title, og:description, og:url,
 *                og:image (+ secure_url, type, width, height, alt)
 *   - Article-only (when ogType === 'article'): article:published_time,
 *     article:modified_time, article:author, article:tag (one per tag)
 *   - Twitter / X: card, title, description, image, image:alt
 *
 * Use as the FIRST child of <head> in every user-facing page (typically
 * via BaseLayout). Pass title/description directly, or look them up via
 * src/lib/seo.ts (STATIC_SEO, getPluginOgImage).
 *
 * The site is hosted at a base path on GitHub Pages (`/content-farm/`),
 * so local OG image paths get the base prepended before being made absolute.
 */
import {
  SITE_NAME,
  DEFAULT_OG_IMAGE,
  DEFAULT_OG_IMAGE_WIDTH,
  DEFAULT_OG_IMAGE_HEIGHT,
  DEFAULT_OG_IMAGE_TYPE,
  DEFAULT_OG_IMAGE_ALT,
  PLUGIN_OG_IMAGE_WIDTH,
  PLUGIN_OG_IMAGE_HEIGHT,
  PLUGIN_OG_IMAGE_TYPE,
  PLUGIN_OG_IMAGE_ALT,
  CHAR_LIMITS,
  buildPageTitle,
  truncate,
} from '../../lib/seo';

interface Props {
  /** Bare title — the suffix " — content-farm" is appended automatically. */
  title: string;
  /** Meta description, also used as og:description and twitter:description. */
  description: string;
  /** Override the OG image. Path (e.g. "/og.png") or absolute URL. */
  ogImage?: string;
  /** Override OG image dimensions when overriding ogImage. */
  ogImageWidth?: number;
  ogImageHeight?: number;
  ogImageType?: string;
  ogImageAlt?: string;
  /** "website" (default), "article", etc. */
  ogType?: string;
  /** Defaults to false (public splash). Set true to opt out of indexing. */
  noindex?: boolean;
  /** Override the canonical URL. Defaults to current page's absolute URL. */
  canonical?: string;
  /** Article-only: ISO publish date. */
  publishedTime?: string;
  /** Article-only: ISO last-modified date. */
  modifiedTime?: string;
  /** Article-only: author display name. */
  author?: string;
  /** Article-only: tag list, emitted as one article:tag per tag. */
  tags?: string[];
}

const {
  title,
  description,
  ogImage,
  ogImageWidth,
  ogImageHeight,
  ogImageType,
  ogImageAlt,
  ogType = 'website',
  noindex = false,
  canonical,
  publishedTime,
  modifiedTime,
  author,
  tags,
} = Astro.props;

// If caller provided a custom ogImage (a CDN URL or different local path),
// trust their dimensions if given; otherwise fall back to plugin-banner standard
// for absolute URLs and the site default for local paths.
const usingDefault = !ogImage || ogImage === DEFAULT_OG_IMAGE;
const isAbsoluteCustom = !!ogImage && ogImage.startsWith('http');

const resolvedImage = ogImage ?? DEFAULT_OG_IMAGE;
const resolvedWidth =
  ogImageWidth ?? (usingDefault ? DEFAULT_OG_IMAGE_WIDTH : isAbsoluteCustom ? PLUGIN_OG_IMAGE_WIDTH : DEFAULT_OG_IMAGE_WIDTH);
const resolvedHeight =
  ogImageHeight ?? (usingDefault ? DEFAULT_OG_IMAGE_HEIGHT : isAbsoluteCustom ? PLUGIN_OG_IMAGE_HEIGHT : DEFAULT_OG_IMAGE_HEIGHT);
const resolvedType =
  ogImageType ?? (usingDefault ? DEFAULT_OG_IMAGE_TYPE : isAbsoluteCustom ? PLUGIN_OG_IMAGE_TYPE : DEFAULT_OG_IMAGE_TYPE);
const resolvedAlt =
  ogImageAlt ?? (usingDefault ? DEFAULT_OG_IMAGE_ALT : isAbsoluteCustom ? PLUGIN_OG_IMAGE_ALT : DEFAULT_OG_IMAGE_ALT);

// Resolve absolute URLs. Astro.site is configured in astro.config.mjs;
// fall back to Astro.url.origin if absent. Append BASE_URL for local paths
// because GitHub Pages serves under /content-farm/.
const siteOrigin = (Astro.site?.toString() ?? Astro.url.origin).replace(/\/$/, '');
const basePath = import.meta.env.BASE_URL.replace(/\/$/, '');

// Astro.url.pathname already includes the base in production, so siteOrigin
// + pathname is the full canonical URL.
const canonicalUrl = canonical ?? `${siteOrigin}${Astro.url.pathname}`;

const absoluteOgImage = resolvedImage.startsWith('http')
  ? resolvedImage
  : `${siteOrigin}${basePath}${resolvedImage.startsWith('/') ? resolvedImage : `/${resolvedImage}`}`;

const fullTitle = truncate(buildPageTitle(title), CHAR_LIMITS.title);
const trimmedDescription = truncate(description ?? '', CHAR_LIMITS.description);
const robotsContent = noindex
  ? 'noindex, nofollow, noarchive, nosnippet'
  : 'index, follow';

const isArticle = ogType === 'article';
---

<title>{fullTitle}</title>
<meta name="description" content={trimmedDescription} />
<meta name="robots" content={robotsContent} />
<link rel="canonical" href={canonicalUrl} />

<!-- OpenGraph -->
<meta property="og:type" content={ogType} />
<meta property="og:site_name" content={SITE_NAME} />
<meta property="og:title" content={fullTitle} />
<meta property="og:description" content={trimmedDescription} />
<meta property="og:url" content={canonicalUrl} />
<meta property="og:image" content={absoluteOgImage} />
<meta property="og:image:secure_url" content={absoluteOgImage} />
<meta property="og:image:type" content={resolvedType} />
<meta property="og:image:width" content={String(resolvedWidth)} />
<meta property="og:image:height" content={String(resolvedHeight)} />
<meta property="og:image:alt" content={resolvedAlt} />

{isArticle && publishedTime && (
  <meta property="article:published_time" content={publishedTime} />
)}
{isArticle && modifiedTime && (
  <meta property="article:modified_time" content={modifiedTime} />
)}
{isArticle && author && (
  <meta property="article:author" content={author} />
)}
{isArticle && tags && tags.map((t) => (
  <meta property="article:tag" content={t} />
))}

<!-- Twitter / X -->
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={fullTitle} />
<meta name="twitter:description" content={trimmedDescription} />
<meta name="twitter:image" content={absoluteOgImage} />
<meta name="twitter:image:alt" content={resolvedAlt} />
