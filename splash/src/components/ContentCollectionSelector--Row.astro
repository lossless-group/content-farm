---
/**
 * ContentCollectionSelector--Row
 *
 * A horizontal row of pill-buttons that filter a sibling list of entries by
 * a data attribute. Click a pill → only items matching that value remain
 * visible (everything else gets the native `hidden` attribute). Click "All"
 * → everything visible again.
 *
 * Pure HTML + CSS + vanilla JS per the Astro Knots tech hierarchy. No state
 * library, no framework. Works without JS too — buttons render, list shows
 * everything, you just can't interact.
 *
 * Usage:
 *
 *   <ContentCollectionSelectorRow
 *     options={[{ value: 'cite-wide', label: 'cite-wide', count: 8 }, ...]}
 *     targetSelector=".archive-list"
 *     matchAttribute="data-from"
 *   />
 *   <ul class="archive-list">
 *     <li data-from="cite-wide">…</li>
 *     <li data-from="content-farm">…</li>
 *   </ul>
 *
 * When the items are spread across several sub-lists under section headings,
 * point `targetSelector` at a common ancestor and pass `groupSelector` so a
 * section whose items all filter out is hidden along with its heading —
 * otherwise you get a run of headings with nothing underneath them:
 *
 *   <ContentCollectionSelectorRow … targetSelector=".groups" groupSelector=".group" />
 */

interface Option {
  /** The value to match against `matchAttribute` on list items. */
  value: string;
  /** Display label on the pill. */
  label: string;
  /** Optional count badge (renders next to the label). */
  count?: number;
}

interface Props {
  /** Sources to filter by. An "All" option is prepended automatically. */
  options: Option[];
  /** CSS selector for the list element whose children will be filtered. */
  targetSelector: string;
  /** Data attribute name (with `data-` prefix) carrying each item's source value. */
  matchAttribute: string;
  /** Initial selected value. Defaults to `all`. */
  defaultValue?: string;
  /** Aria label for the row of buttons. */
  label?: string;
  /** Optional id; useful only if multiple rows exist on the same page. */
  id?: string;
  /**
   * Optional selector (within the target) for section wrappers. Any section
   * left with no visible items is hidden too, so headings don't strand.
   */
  groupSelector?: string;
}

const {
  options,
  targetSelector,
  matchAttribute,
  defaultValue = 'all',
  label = 'Filter by source',
  id,
  groupSelector,
} = Astro.props;

const totalCount = options.reduce((acc, o) => acc + (o.count ?? 0), 0);
const merged: Option[] = [
  { value: 'all', label: 'All', count: totalCount > 0 ? totalCount : undefined },
  ...options,
];
---

<nav
  class="cc-selector"
  {...(id ? { id } : {})}
  aria-label={label}
  data-target-selector={targetSelector}
  data-match-attribute={matchAttribute}
  {...(groupSelector ? { 'data-group-selector': groupSelector } : {})}
>
  <ul class="cc-selector-list" role="list">
    {
      merged.map((opt) => (
        <li>
          <button
            class="cc-selector-btn"
            type="button"
            data-cc-value={opt.value}
            aria-pressed={opt.value === defaultValue ? 'true' : 'false'}
          >
            <span class="cc-selector-label">{opt.label}</span>
            {opt.count != null && <span class="cc-selector-count">{opt.count}</span>}
          </button>
        </li>
      ))
    }
  </ul>
</nav>

<style>
  .cc-selector {
    margin-bottom: var(--space-8);
  }
  .cc-selector-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
  }
  .cc-selector-btn {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    padding: 8px 14px;
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.03);
    border: 1px solid var(--clr-border);
    color: var(--clr-text-soft);
    font-family: var(--ff-mono);
    font-size: 0.8rem;
    line-height: 1;
    cursor: pointer;
    transition:
      color 180ms ease,
      background 180ms ease,
      border-color 180ms ease,
      transform 180ms ease;
  }
  .cc-selector-btn:hover {
    color: var(--clr-text);
    border-color: var(--clr-border-strong);
    background: rgba(255, 255, 255, 0.06);
  }
  .cc-selector-btn:focus-visible {
    outline: 2px solid var(--clr-cyan);
    outline-offset: 3px;
  }
  .cc-selector-btn[aria-pressed='true'] {
    color: #0a0a0f;
    background: linear-gradient(120deg, var(--clr-cyan), var(--clr-aquamarine));
    border-color: transparent;
    font-weight: 600;
  }
  .cc-selector-btn[aria-pressed='true']:hover {
    color: #0a0a0f;
    transform: translateY(-1px);
  }
  .cc-selector-count {
    display: inline-flex;
    align-items: center;
    min-width: 1.25em;
    justify-content: center;
    font-size: 0.7rem;
    opacity: 0.85;
    padding: 1px 6px;
    border-radius: 999px;
    background: rgba(0, 0, 0, 0.18);
  }
  .cc-selector-btn[aria-pressed='true'] .cc-selector-count {
    background: rgba(0, 0, 0, 0.22);
  }
</style>

<script>
  // Wires up every ContentCollectionSelector--Row on the page.
  //
  // Rows that share a `targetSelector` filter the SAME list and are combined
  // with AND: an item stays visible only if it satisfies every row. That is
  // what lets a page offer "filter by type" and "filter by source repo" at once
  // — filtering each independently would have the two rows overwrite each
  // other's `hidden` flags and produce nonsense.
  const roots = Array.from(document.querySelectorAll<HTMLElement>('.cc-selector'));

  // Group rows by the list they act on.
  const byTarget = new Map<string, HTMLElement[]>();
  roots.forEach((root) => {
    const t = root.dataset.targetSelector;
    if (!t || !root.dataset.matchAttribute) return;
    if (!byTarget.has(t)) byTarget.set(t, []);
    byTarget.get(t)!.push(root);
  });

  byTarget.forEach((group, targetSelector) => {
    const list = document.querySelector(targetSelector);
    if (!list) return;

    const attrs = group.map((r) => r.dataset.matchAttribute!) as string[];
    // An item is filterable if it carries any of the attributes in play.
    const items = Array.from(
      list.querySelectorAll<HTMLElement>(attrs.map((a) => `[${a}]`).join(',')),
    );
    const groupSelector = group.find((r) => r.dataset.groupSelector)?.dataset.groupSelector;

    function activeValue(root: HTMLElement): string {
      const pressed = root.querySelector<HTMLButtonElement>('button[aria-pressed="true"]');
      return pressed?.dataset.ccValue ?? 'all';
    }

    function apply(): void {
      items.forEach((item) => {
        const visible = group.every((root) => {
          const value = activeValue(root);
          if (value === 'all') return true;
          return item.getAttribute(root.dataset.matchAttribute!) === value;
        });
        item.toggleAttribute('hidden', !visible);
      });

      // Hide any section left with nothing in it — a heading with no items
      // under it reads as a rendering bug.
      if (groupSelector) {
        list.querySelectorAll<HTMLElement>(groupSelector).forEach((section) => {
          const anyVisible = Array.from(
            section.querySelectorAll<HTMLElement>(attrs.map((a) => `[${a}]`).join(',')),
          ).some((item) => !item.hasAttribute('hidden'));
          section.toggleAttribute('hidden', !anyVisible);
        });
      }
    }

    group.forEach((root) => {
      root.addEventListener('click', (event) => {
        const target = event.target as HTMLElement | null;
        const btn = target?.closest<HTMLButtonElement>('button[data-cc-value]');
        if (!btn) return;
        const value = btn.dataset.ccValue;
        if (value === undefined) return;

        root.querySelectorAll<HTMLButtonElement>('button[data-cc-value]').forEach((b) => {
          b.setAttribute('aria-pressed', b.dataset.ccValue === value ? 'true' : 'false');
        });
        apply();
      });
    });
  });
</script>
