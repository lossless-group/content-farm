---
import CtaButton from './basics/CtaButton.astro';

interface Props {
  /** Display title. */
  title: string;
  /** Plugin slug (used to build the /plugins/<slug>/ share URL). */
  slug?: string;
  lede?: string;
  status?: string;
  repo?: string;
  icon?: string;
  featured?: boolean;
  tags?: string[];
  /**
   * Optional override for the card's primary click target (the wrapping
   * card-link `<a>`). Defaults to `landingHref` if present, otherwise repo.
   */
  href?: string;
  /**
   * Optional landing-page URL on this site for plugins that have a
   * dedicated page (today: only perplexed at `/perplexed/`). When set:
   *   - card-link's primary target becomes this URL (instead of repo)
   *   - a primary CTA button appears in the card footer pointing here
   *   - the GitHub icon in the footer remains the only path to the repo
   * When omitted, the card behaves as before: card-link → repo, footer
   * shows only the GitHub icon.
   */
  landingHref?: string;
  /**
   * URL on community.obsidian.md for plugins accepted into Obsidian's
   * Community Plugins directory. When set:
   *   - a "Community Plugin" pill renders next to the status pill
   *   - an Obsidian-purple icon button appears in the card footer next to
   *     the GitHub icon, linking to community.obsidian.md/plugins/<slug>
   *   - the card gets a subtle purple accent on its border-top to
   *     differentiate published plugins from dev-only ones at a glance
   */
  communityUrl?: string;
}

const {
  title,
  slug,
  lede,
  status,
  repo,
  icon,
  featured = false,
  tags = [],
  href,
  landingHref,
  communityUrl,
} = Astro.props;

const base = import.meta.env.BASE_URL;

// Card-link primary target precedence: explicit href → landing page → repo.
// When a landing page exists, clicking the card body goes to that page;
// the GitHub icon in the footer is the explicit route to the repo.
const primaryHref = href ?? landingHref ?? repo ?? '#';
const primaryExternal = !href && !landingHref;
const shareUrl = slug ? `${base}plugins/${slug}/` : undefined;
const shareTitle = title;
const shareText = lede ?? `${title} — content-farm plugin.`;
---

<article class={`card ${featured ? 'card--featured' : ''} ${communityUrl ? 'card--community' : ''}`}>
  <a
    class="card-link"
    href={primaryHref}
    target={primaryExternal ? '_blank' : '_self'}
    rel={primaryExternal ? 'noopener' : undefined}
    aria-label={landingHref ? `${title} — go to plugin page` : `${title} — view repo`}
  >
    <div class="card-inner">
      <header class="card-head">
        {icon && <div class="card-icon" aria-hidden="true">{icon}</div>}
        <div class="card-title-block">
          <h3 class="card-title">{title}</h3>
          <div class="card-pills">
            {status && <span class="pill" data-status={status}>{status}</span>}
            {communityUrl && (
              <span class="pill pill--community" title="Available in Obsidian's Community Plugins directory">
                <svg
                  class="pill-icon"
                  viewBox="0 0 22 25"
                  width="11"
                  height="13"
                  aria-hidden="true"
                >
                  <path
                    fill="currentColor"
                    d="m6.91927 14.5955c.64053-.1907 1.67255-.4839 2.85923-.5565-.71191-1.7968-.88376-3.3691-.74554-4.76905.15962-1.61678.72977-2.9662 1.28554-4.11442.1186-.24501.2326-.47313.3419-.69198.1549-.30984.3004-.60109.4365-.8953.2266-.48978.3948-.92231.4798-1.32416.0836-.39515.0841-.74806-.0148-1.08657-.099-.338982-.3093-.703864-.7093-1.1038132-.5222-.1353116-1.1017-.0165173-1.53613.3742922l-5.15591 4.638241c-.28758.25871-.47636.60929-.53406.99179l-.44455 2.94723c.69903.6179 2.42435 2.41414 3.47374 4.90644.09364.2224.1819.4505.26358.6838z"
                  />
                  <path
                    fill="currentColor"
                    d="m2.97347 10.3512c-.02431.1037-.05852.205-.10221.3024l-2.724986 6.0735c-.279882.6238-.15095061 1.3552.325357 1.8457l4.288349 4.4163c2.1899-3.2306 1.87062-6.2699.87032-8.6457-.75846-1.8013-1.90801-3.2112-2.65683-3.9922z"
                  />
                  <path
                    fill="currentColor"
                    d="m5.7507 23.5094c.07515.012.15135.0192.2281.0215.81383.0244 2.18251.0952 3.29249.2997.90551.1669 2.70051.6687 4.17761 1.1005 1.1271.3294 2.2886-.5707 2.4522-1.7336.1192-.8481.343-1.8075.7553-2.6869l-.0095.0033c-.6982-1.9471-1.5865-3.2044-2.5178-4.0073-.9284-.8004-1.928-1.1738-2.8932-1.3095-1.60474-.2257-3.07497.1961-4.00103.4682.55465 2.3107.38396 5.0295-1.48417 7.8441z"
                  />
                  <path
                    fill="currentColor"
                    d="m17.3708 19.3102c.9267-1.3985 1.5868-2.4862 1.9352-3.0758.1742-.295.1427-.6648-.0638-.9383-.5377-.7126-1.5666-2.1607-2.1272-3.5015-.5764-1.3785-.6624-3.51876-.6673-4.56119-.0019-.39626-.1275-.78328-.3726-1.09465l-3.3311-4.23183c-.0117.19075-.0392.37998-.0788.56747-.1109.52394-.32 1.04552-.5585 1.56101-.1398.30214-.3014.62583-.4646.95284-.1086.21764-.218.4368-.3222.652-.5385 1.11265-1.0397 2.32011-1.1797 3.73901-.1299 1.31514.0478 2.84484.8484 4.67094.1333.0113.2675.0262.4023.0452 1.1488.1615 2.3546.6115 3.4647 1.5685.9541.8226 1.8163 2.0012 2.5152 3.6463z"
                  />
                </svg>
                Community Plugin
              </span>
            )}
          </div>
        </div>
      </header>
      {lede && <p class="card-lede">{lede}</p>}
      <slot />
      {tags.length > 0 && (
        <div class="card-tags">
          {tags.map((t) => <span class="card-tag">{t}</span>)}
        </div>
      )}
    </div>
  </a>

  {/*
    Footer is a sibling of card-link so the GitHub icon and the CTA button
    aren't anchors-inside-anchor. Always renders the GitHub icon when a
    repo URL is present; renders the primary CTA only when this plugin
    has a dedicated landing page (today: perplexed).
  */}
  {(repo || landingHref || communityUrl) && (
    <footer class="card-foot">
      {communityUrl && (
        <a
          class="card-community"
          href={communityUrl}
          target="_blank"
          rel="noopener"
          aria-label={`${title} — install from Obsidian's Community Plugins directory`}
          title="Install from Obsidian Community Plugins"
        >
          <svg
            class="card-community-icon"
            viewBox="0 0 22 25"
            aria-hidden="true"
          >
            <path
              fill="currentColor"
              d="m6.91927 14.5955c.64053-.1907 1.67255-.4839 2.85923-.5565-.71191-1.7968-.88376-3.3691-.74554-4.76905.15962-1.61678.72977-2.9662 1.28554-4.11442.1186-.24501.2326-.47313.3419-.69198.1549-.30984.3004-.60109.4365-.8953.2266-.48978.3948-.92231.4798-1.32416.0836-.39515.0841-.74806-.0148-1.08657-.099-.338982-.3093-.703864-.7093-1.1038132-.5222-.1353116-1.1017-.0165173-1.53613.3742922l-5.15591 4.638241c-.28758.25871-.47636.60929-.53406.99179l-.44455 2.94723c.69903.6179 2.42435 2.41414 3.47374 4.90644.09364.2224.1819.4505.26358.6838z"
            />
            <path
              fill="currentColor"
              d="m2.97347 10.3512c-.02431.1037-.05852.205-.10221.3024l-2.724986 6.0735c-.279882.6238-.15095061 1.3552.325357 1.8457l4.288349 4.4163c2.1899-3.2306 1.87062-6.2699.87032-8.6457-.75846-1.8013-1.90801-3.2112-2.65683-3.9922z"
            />
            <path
              fill="currentColor"
              d="m5.7507 23.5094c.07515.012.15135.0192.2281.0215.81383.0244 2.18251.0952 3.29249.2997.90551.1669 2.70051.6687 4.17761 1.1005 1.1271.3294 2.2886-.5707 2.4522-1.7336.1192-.8481.343-1.8075.7553-2.6869l-.0095.0033c-.6982-1.9471-1.5865-3.2044-2.5178-4.0073-.9284-.8004-1.928-1.1738-2.8932-1.3095-1.60474-.2257-3.07497.1961-4.00103.4682.55465 2.3107.38396 5.0295-1.48417 7.8441z"
            />
            <path
              fill="currentColor"
              d="m17.3708 19.3102c.9267-1.3985 1.5868-2.4862 1.9352-3.0758.1742-.295.1427-.6648-.0638-.9383-.5377-.7126-1.5666-2.1607-2.1272-3.5015-.5764-1.3785-.6624-3.51876-.6673-4.56119-.0019-.39626-.1275-.78328-.3726-1.09465l-3.3311-4.23183c-.0117.19075-.0392.37998-.0788.56747-.1109.52394-.32 1.04552-.5585 1.56101-.1398.30214-.3014.62583-.4646.95284-.1086.21764-.218.4368-.3222.652-.5385 1.11265-1.0397 2.32011-1.1797 3.73901-.1299 1.31514.0478 2.84484.8484 4.67094.1333.0113.2675.0262.4023.0452 1.1488.1615 2.3546.6115 3.4647 1.5685.9541.8226 1.8163 2.0012 2.5152 3.6463z"
            />
          </svg>
        </a>
      )}
      {repo && (
        <a
          class="card-github"
          href={repo}
          target="_blank"
          rel="noopener"
          aria-label={`${title} — open repository on GitHub`}
          title="View on GitHub"
        >
          <svg
            class="card-github-icon"
            viewBox="0 0 24 24"
            aria-hidden="true"
            fill="currentColor"
          >
            <path d="M12 .5A11.5 11.5 0 0 0 .5 12c0 5.08 3.29 9.39 7.86 10.91.58.11.79-.25.79-.56 0-.28-.01-1.02-.02-2.01-3.2.69-3.88-1.54-3.88-1.54-.52-1.33-1.28-1.69-1.28-1.69-1.04-.71.08-.7.08-.7 1.15.08 1.76 1.18 1.76 1.18 1.03 1.76 2.69 1.25 3.35.96.1-.74.4-1.25.73-1.54-2.55-.29-5.24-1.28-5.24-5.69 0-1.26.45-2.29 1.18-3.1-.12-.29-.51-1.46.11-3.05 0 0 .97-.31 3.18 1.18a11.05 11.05 0 0 1 5.79 0c2.21-1.49 3.18-1.18 3.18-1.18.62 1.59.23 2.76.11 3.05.74.81 1.18 1.84 1.18 3.1 0 4.42-2.7 5.39-5.26 5.68.41.36.78 1.06.78 2.13 0 1.54-.01 2.78-.01 3.16 0 .31.21.68.79.56A11.5 11.5 0 0 0 23.5 12 11.5 11.5 0 0 0 12 .5Z" />
          </svg>
        </a>
      )}
      {landingHref && (
        <CtaButton href={landingHref} variant="primary" class="card-cta-btn">
          View page →
        </CtaButton>
      )}
    </footer>
  )}

  {shareUrl && (
    <button
      type="button"
      class="card-share"
      data-share-url={shareUrl}
      data-share-title={shareTitle}
      data-share-text={shareText}
      aria-label={`Share ${title}`}
      title={`Share ${title}`}
    >
      <svg
        class="card-share-icon"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
        aria-hidden="true"
      >
        <circle cx="18" cy="5" r="3" />
        <circle cx="6" cy="12" r="3" />
        <circle cx="18" cy="19" r="3" />
        <line x1="8.59" y1="13.51" x2="15.42" y2="17.49" />
        <line x1="15.41" y1="6.51" x2="8.59" y2="10.49" />
      </svg>
      <span class="card-share-feedback" aria-live="polite"></span>
    </button>
  )}
</article>

<style>
  .card {
    --card-accent: var(--clr-cyan);
    position: relative;
    border-radius: var(--radius-lg);
    background: var(--clr-bg-card);
    border: 1px solid var(--clr-border);
    backdrop-filter: blur(8px);
    transition: transform 220ms ease, border-color 220ms ease, box-shadow 220ms ease;
    overflow: hidden;
    isolation: isolate;
    /* Footer pins to the bottom while card-link content grows. Required
       because the footer is now a sibling of card-link, not nested. */
    display: flex;
    flex-direction: column;
  }
  .card::before {
    content: '';
    position: absolute;
    inset: 0;
    background: radial-gradient(
      400px circle at var(--mx, 50%) var(--my, 0%),
      rgba(4, 229, 229, 0.08),
      transparent 40%
    );
    opacity: 0;
    transition: opacity 200ms ease;
    z-index: 0;
    pointer-events: none;
  }
  .card:hover {
    transform: translateY(-3px);
    border-color: var(--clr-border-accent);
    box-shadow: 0 12px 40px rgba(0, 0, 0, 0.4), var(--shadow-glow-cyan);
  }
  .card:hover::before {
    opacity: 1;
  }

  .card--featured {
    --card-accent: var(--clr-aquamarine);
    background: linear-gradient(
      135deg,
      rgba(4, 229, 229, 0.06),
      rgba(191, 35, 247, 0.06)
    ),
    var(--clr-bg-card);
  }

  /* Published-to-Community-Plugins differentiator. Obsidian's brand purple
     reads as the signal — a thin top accent + slightly stronger default
     border so the published cards visibly cluster vs. dev-only ones. */
  .card--community {
    border-top: 2px solid rgba(168, 139, 250, 0.55);
  }
  .card--community:hover {
    border-top-color: rgba(168, 139, 250, 0.9);
  }

  .card-link {
    display: block;
    color: inherit;
    text-decoration: none;
    flex: 1 1 auto;
  }
  .card-link:hover {
    color: inherit;
  }

  .card-inner {
    position: relative;
    z-index: 1;
    padding: var(--space-6);
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
    height: 100%;
  }

  .card-head {
    display: flex;
    gap: var(--space-4);
    align-items: flex-start;
    /* Reserve space so the share button never overlaps the title. */
    padding-right: 36px;
  }
  .card-icon {
    font-size: 1.75rem;
    line-height: 1;
    flex-shrink: 0;
    width: 44px;
    height: 44px;
    display: grid;
    place-items: center;
    border-radius: var(--radius-sm);
    background: rgba(255, 255, 255, 0.04);
    border: 1px solid var(--clr-border);
  }
  .card-title-block {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    min-width: 0;
  }
  .card-pills {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    align-items: center;
  }
  .pill--community {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    background: rgba(168, 139, 250, 0.12);
    color: #c4adfb;
    border: 1px solid rgba(168, 139, 250, 0.35);
  }
  .pill-icon {
    flex-shrink: 0;
  }
  .card-title {
    font-size: 1.25rem;
    font-family: var(--ff-mono);
    font-weight: 600;
    letter-spacing: -0.01em;
    color: var(--clr-text);
  }
  .card--featured .card-title {
    font-size: 1.5rem;
  }

  .card-lede {
    color: var(--clr-text-soft);
    font-size: 0.95rem;
    line-height: 1.55;
    flex-grow: 1;
  }

  /* Tags now live inside the card-link content area, above the footer. */
  .card-tags {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
  }
  .card-tag {
    font-family: var(--ff-mono);
    font-size: 0.7rem;
    letter-spacing: 0.04em;
    color: var(--clr-text-dim);
    padding: 2px 8px;
    border-radius: 4px;
    background: rgba(255, 255, 255, 0.03);
  }

  /* Card footer — sibling of .card-link so the buttons inside are real
     links, not anchors-in-anchor. Positioned at the bottom of the card
     with a top border that visually continues the card-link section.
     z-index above .card-link so clicks land on the buttons rather than
     bubbling up to the wrapping link. */
  .card-foot {
    position: relative;
    z-index: 2;
    display: flex;
    align-items: center;
    justify-content: flex-end;
    gap: var(--space-3);
    padding: var(--space-4) var(--space-6) var(--space-6);
    border-top: 1px solid var(--clr-border);
  }

  /* GitHub icon button — same shape as the share button (top-right of
     card) so the two share a visual vocabulary. Subtle by default,
     brightens on hover/focus to the card's accent. */
  .card-github {
    display: grid;
    place-items: center;
    width: 36px;
    height: 36px;
    border-radius: 999px;
    border: 1px solid var(--clr-border);
    background: rgba(10, 10, 15, 0.55);
    color: var(--clr-text-dim);
    text-decoration: none;
    transition:
      color 180ms ease,
      border-color 180ms ease,
      background 180ms ease,
      transform 180ms ease;
  }
  .card-github:hover,
  .card-github:focus-visible {
    color: var(--card-accent);
    border-color: var(--clr-border-accent);
    background: rgba(4, 229, 229, 0.08);
    transform: translateY(-1px);
  }
  .card-github:focus-visible {
    outline: 2px solid var(--clr-cyan);
    outline-offset: 2px;
  }
  .card-github-icon {
    width: 18px;
    height: 18px;
  }

  /* Obsidian-community-plugin link, sibling of the GitHub icon. Same shape
     (36px circle) for visual consistency, but in Obsidian's brand purple
     so the click target reads as "install via Obsidian's directory." */
  .card-community {
    display: grid;
    place-items: center;
    width: 36px;
    height: 36px;
    border-radius: 999px;
    border: 1px solid rgba(168, 139, 250, 0.35);
    background: rgba(168, 139, 250, 0.08);
    color: #a88bfa;
    text-decoration: none;
    transition:
      color 180ms ease,
      border-color 180ms ease,
      background 180ms ease,
      transform 180ms ease;
  }
  .card-community:hover,
  .card-community:focus-visible {
    color: #c4adfb;
    border-color: rgba(168, 139, 250, 0.7);
    background: rgba(168, 139, 250, 0.18);
    transform: translateY(-1px);
  }
  .card-community:focus-visible {
    outline: 2px solid #a88bfa;
    outline-offset: 2px;
  }
  .card-community-icon {
    width: 16px;
    height: 18px;
  }

  /* CTA button at card scale — quieter and shorter than the hero-scale
     primary CtaButton it borrows from. Keeps the gradient identity but:
     - drops the cyan glow shadow at rest (too loud against the muted
       GitHub icon next to it)
     - tightens vertical padding so the button sits closer to the
       GitHub icon's 36px height
     - slightly smaller font-size for card scale
     Hover keeps a soft shadow so the affordance is still felt. */
  :global(.card-foot .card-cta-btn) {
    padding: 7px 16px;
    font-size: 0.78rem;
    box-shadow: none;
  }
  :global(.card-foot .card-cta-btn:hover) {
    box-shadow: 0 4px 12px rgba(4, 229, 229, 0.22);
  }

  /* ───── Share button ─────
     Sibling of .card-link so it isn't a button-inside-anchor. Sits
     absolutely top-right of the card, subtle by default and brightens
     on hover/focus. */
  .card-share {
    position: absolute;
    top: var(--space-3);
    right: var(--space-3);
    z-index: 2;
    width: 32px;
    height: 32px;
    padding: 0;
    display: grid;
    place-items: center;
    border-radius: 999px;
    border: 1px solid var(--clr-border);
    background: rgba(10, 10, 15, 0.55);
    color: var(--clr-text-dim);
    cursor: pointer;
    transition:
      color 180ms ease,
      border-color 180ms ease,
      background 180ms ease,
      transform 180ms ease;
  }
  .card-share:hover,
  .card-share:focus-visible {
    color: var(--card-accent);
    border-color: var(--clr-border-accent);
    background: rgba(4, 229, 229, 0.08);
    transform: translateY(-1px);
  }
  .card-share:focus-visible {
    outline: 2px solid var(--clr-cyan);
    outline-offset: 2px;
  }
  .card-share-icon {
    width: 14px;
    height: 14px;
  }
  /* Visual feedback when clipboard fallback fires. */
  .card-share[data-copied='true'] {
    color: var(--clr-aquamarine);
    border-color: rgba(111, 255, 214, 0.4);
    background: rgba(111, 255, 214, 0.08);
  }
  .card-share-feedback {
    position: absolute;
    bottom: calc(100% + 6px);
    right: 0;
    padding: 4px 8px;
    font-family: var(--ff-mono);
    font-size: 0.7rem;
    letter-spacing: 0.04em;
    color: var(--clr-text);
    background: var(--clr-bg-elevated);
    border: 1px solid var(--clr-border-strong);
    border-radius: 6px;
    white-space: nowrap;
    opacity: 0;
    pointer-events: none;
    transform: translateY(2px);
    transition: opacity 160ms ease, transform 160ms ease;
  }
  .card-share[data-copied='true'] .card-share-feedback {
    opacity: 1;
    transform: translateY(0);
  }
</style>

<script>
  // Pointer tracking for the radial highlight on hover. Vanilla JS, no deps.
  document.querySelectorAll('.card').forEach((card) => {
    card.addEventListener('pointermove', (e) => {
      const event = e as PointerEvent;
      const rect = (card as HTMLElement).getBoundingClientRect();
      const x = ((event.clientX - rect.left) / rect.width) * 100;
      const y = ((event.clientY - rect.top) / rect.height) * 100;
      (card as HTMLElement).style.setProperty('--mx', `${x}%`);
      (card as HTMLElement).style.setProperty('--my', `${y}%`);
    });
  });

  // Share button — Web Share API with clipboard fallback.
  // The shared URL points to /plugins/<slug>/ on this site, which carries
  // the plugin's banner_image as og:image. So the recipient unfurls the
  // plugin's specific OG, not the splash default.
  document.querySelectorAll<HTMLButtonElement>('.card-share').forEach((button) => {
    button.addEventListener('click', async (e) => {
      e.preventDefault();
      e.stopPropagation();

      const relPath = button.dataset.shareUrl;
      const title = button.dataset.shareTitle ?? '';
      const text = button.dataset.shareText ?? '';
      if (!relPath) return;

      // Resolve to absolute URL so platforms that prefetch get a clean target.
      const fullUrl = new URL(relPath, window.location.origin).toString();

      const showCopied = (label: string) => {
        const feedback = button.querySelector('.card-share-feedback');
        if (feedback) feedback.textContent = label;
        button.dataset.copied = 'true';
        window.setTimeout(() => {
          delete button.dataset.copied;
        }, 1800);
      };

      // Prefer the native share sheet when available (mobile + some desktops).
      if (typeof navigator.share === 'function') {
        try {
          await navigator.share({ title, text, url: fullUrl });
          return;
        } catch (err) {
          // AbortError = user dismissed; fall through to clipboard only on
          // genuine failure.
          if ((err as DOMException)?.name === 'AbortError') return;
        }
      }

      // Clipboard fallback.
      try {
        await navigator.clipboard.writeText(fullUrl);
        showCopied('Link copied');
      } catch {
        // Last resort: open the share URL in a new tab so the user can
        // copy it from the address bar.
        window.open(fullUrl, '_blank', 'noopener');
      }
    });
  });
</script>
