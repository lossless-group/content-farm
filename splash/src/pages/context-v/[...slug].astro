---
import { getCollection } from 'astro:content';
import { parseMarkdown } from '@lossless-group/lfm';
import BaseLayout from '../../layouts/BaseLayout.astro';
import MarkdownReader from '../../components/markdown/MarkdownReader.astro';
import EntryNav from '../../components/EntryNav.astro';
import { getPluginOgImage } from '../../lib/seo';

function navSlotFor(e: any | undefined) {
  if (!e) return undefined;
  const d = e.data.date_modified ?? e.data.date_last_updated ?? e.data.date_created ?? e.data.date_authored_current_draft ?? e.data.date_authored_initial_draft;
  return {
    href: `${import.meta.env.BASE_URL}context-v/${e.id}`,
    title: e.data.title ?? e.id.split('/').pop(),
    date: d ? new Date(d).toISOString().slice(0, 10) : undefined,
  };
}

export async function getStaticPaths() {
  let entries: Awaited<ReturnType<typeof getCollection<'context-v'>>> = [];
  try {
    entries = (await getCollection('context-v')).filter((e) => e.data.publish !== false);
  } catch {
    entries = [];
  }
  return entries.map((entry) => ({
    params: { slug: entry.id },
    props: { entry },
  }));
}

const { entry } = Astro.props;
// LFM pipeline (same as changelog/[...slug].astro): parse the body into an
// MDAST tree, then hand it to <MarkdownReader> which walks via <AstroMarkdown>
// and renders callouts, code blocks, images, and hex-code citations through
// the site's component registry.
const tree = await parseMarkdown(entry.body ?? '');
const citations = ((tree as any)?.data?.citations?.ordered ?? []) as any[];
const date = entry.data.date_modified ?? entry.data.date_last_updated ?? entry.data.date_created ?? entry.data.date_authored_current_draft ?? entry.data.date_authored_initial_draft;
const base = import.meta.env.BASE_URL;

// Derive prev/next entries for the bottom nav. Sort: newest first by
// date_modified > date_last_updated > date_created. "Previous" (←) = newer
// entry (index-1); "Next" (→) = older entry (index+1). Boundaries render
// as disabled stubs so the three-slot layout stays stable.
type Entry = (typeof entry);
let allEntries: Entry[] = [];
try {
  allEntries = (await getCollection('context-v'))
    .filter((e) => e.data.publish !== false)
    .sort((a, b) => {
      const dA = a.data.date_modified ?? a.data.date_last_updated ?? a.data.date_created ?? a.data.date_authored_current_draft ?? a.data.date_authored_initial_draft ?? new Date(0);
      const dB = b.data.date_modified ?? b.data.date_last_updated ?? b.data.date_created ?? b.data.date_authored_current_draft ?? b.data.date_authored_initial_draft ?? new Date(0);
      return new Date(dB).getTime() - new Date(dA).getTime();
    });
} catch {
  allEntries = [];
}
const currentIdx = allEntries.findIndex((e) => e.id === entry.id);
const prevEntry: Entry | undefined = currentIdx > 0 ? allEntries[currentIdx - 1] : undefined;
const nextEntry: Entry | undefined = currentIdx >= 0 && currentIdx < allEntries.length - 1 ? allEntries[currentIdx + 1] : undefined;
// Section is the second path segment (first is provenance). Root-level files
// fall back to "general".
const segments = entry.id.split('/');
const sectionLabel = segments.length > 2 ? segments[1] : 'general';

// SEO derivation — per-page metadata pulled from the entry, with the OG
// image falling back to the originating plugin's banner_image when the
// entry came from a plugin submodule.
const pageTitle = entry.data.title ?? entry.id.split('/').pop() ?? entry.id;
const pageDescription =
  entry.data.lede ?? entry.data.description ?? entry.data.purpose ??
  `${sectionLabel.charAt(0).toUpperCase() + sectionLabel.slice(1)} note from ${entry.data.from ?? 'content-farm'}.`;
const pluginOg = await getPluginOgImage(entry.data.from);
const publishedTime = (entry.data.date_created ?? entry.data.date_authored_initial_draft)?.toISOString();
const modifiedTime = (entry.data.date_modified ?? entry.data.date_last_updated ?? entry.data.date_created ?? entry.data.date_authored_current_draft ?? entry.data.date_authored_initial_draft)?.toISOString();
const articleAuthor = entry.data.authors?.[0];
const articleTags = entry.data.tags;
---

<BaseLayout
  title={pageTitle}
  description={pageDescription}
  ogImage={pluginOg}
  ogType="article"
  publishedTime={publishedTime}
  modifiedTime={modifiedTime}
  author={articleAuthor}
  tags={articleTags}
>
  <main class="container reading">
    <EntryNav
      prev={navSlotFor(prevEntry)}
      next={navSlotFor(nextEntry)}
      backHref={`${base}context-v`}
      backLabel="All notes"
      ariaLabel="Adjacent notes (top)"
      variant="compact"
    />

    <article>
      <header class="reading-head">
        <p class="reading-section">{sectionLabel}</p>
        <h1>{entry.data.title ?? entry.id.split('/').pop()}</h1>
        {entry.data.lede && <p class="reading-lede">{entry.data.lede}</p>}
        {!entry.data.lede && entry.data.description && <p class="reading-lede">{entry.data.description}</p>}
        {!entry.data.lede && !entry.data.description && entry.data.purpose && <p class="reading-lede">{entry.data.purpose}</p>}
        <div class="reading-meta">
          {entry.data.from && entry.data.from !== 'content-farm' && (
            <span class="from-tag">{entry.data.from}</span>
          )}
          {entry.data.status && <span class="pill" data-status={entry.data.status}>{entry.data.status}</span>}
          {entry.data.semantic_version && <span class="pill mono">v{entry.data.semantic_version}</span>}
          {date && (
            <time class="mono dim" datetime={new Date(date).toISOString()}>
              {new Date(date).toISOString().slice(0, 10)}
            </time>
          )}
        </div>
      </header>

      <MarkdownReader tree={tree} citations={citations} backHref={`${base}context-v`} backLabelTxt="All notes" />
    </article>

    <EntryNav
      prev={navSlotFor(prevEntry)}
      next={navSlotFor(nextEntry)}
      backHref={`${base}context-v`}
      backLabel="All notes"
      ariaLabel="Adjacent notes (bottom)"
    />
  </main>
</BaseLayout>

<style>
  .reading {
    padding: clamp(3rem, 8vh, 6rem) 0 var(--space-16);
  }
  .reading-back {
    font-family: var(--ff-mono);
    font-size: 0.875rem;
    margin-bottom: var(--space-8);
  }
  .reading-head {
    max-width: 70ch;
    margin: 0 auto var(--space-12);
  }
  .reading-section {
    font-family: var(--ff-mono);
    font-size: 0.75rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--clr-aquamarine);
    margin-bottom: var(--space-3);
  }
  .reading-head h1 {
    font-size: clamp(2rem, 4.5vw, 3.25rem);
    line-height: 1.1;
  }
  .reading-lede {
    margin-top: var(--space-4);
    color: var(--clr-text-soft);
    font-size: 1.15rem;
    line-height: 1.5;
  }
  .reading-meta {
    margin-top: var(--space-6);
    display: flex;
    gap: var(--space-3);
    align-items: center;
    flex-wrap: wrap;
  }
  .dim { color: var(--clr-text-dim); }
</style>
