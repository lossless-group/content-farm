---
import { getCollection } from 'astro:content';
import { parseMarkdown } from '@lossless-group/lfm';
import BaseLayout from '../../layouts/BaseLayout.astro';
import MarkdownReader from '../../components/markdown/MarkdownReader.astro';
import { getPluginOgImage } from '../../lib/seo';

export async function getStaticPaths() {
  let entries: Awaited<ReturnType<typeof getCollection<'changelog'>>> = [];
  try {
    entries = await getCollection('changelog');
  } catch {
    entries = [];
  }
  return entries.map((entry) => ({
    params: { slug: entry.id },
    props: { entry },
  }));
}

const { entry } = Astro.props;
// LFM pipeline: parse the body into an MDAST tree, then hand it to
// <MarkdownReader> which walks the tree via <AstroMarkdown> and renders
// callouts, code blocks, images, and hex-code citations through the
// site's component registry. Citations land in tree.data.citations.ordered
// when remarkCitations finds any.
const tree = await parseMarkdown(entry.body ?? '');
const citations = ((tree as any)?.data?.citations?.ordered ?? []) as any[];
const date = entry.data.date_modified ?? entry.data.date_created ?? entry.data.date;
const base = import.meta.env.BASE_URL;

// Derive prev/next entries for the bottom nav. Sort matches the changelog
// index page: newest first by date_modified > date_created > date. In that
// sort, "Previous" (←) points at the NEWER entry (one position earlier in
// the array) and "Next" (→) at the OLDER one. Wrapping does NOT happen at
// the boundaries — at the newest entry, prev is null; at the oldest, next
// is null. The buttons render as disabled stubs in those positions so the
// nav layout stays stable.
type Entry = (typeof entry);
let allEntries: Entry[] = [];
try {
  allEntries = (await getCollection('changelog'))
    .filter((e) => e.data.publish !== false)
    .sort((a, b) => {
      const dA = a.data.date_modified ?? a.data.date_created ?? a.data.date ?? new Date(0);
      const dB = b.data.date_modified ?? b.data.date_created ?? b.data.date ?? new Date(0);
      return new Date(dB).getTime() - new Date(dA).getTime();
    });
} catch {
  allEntries = [];
}
const currentIdx = allEntries.findIndex((e) => e.id === entry.id);
const prevEntry: Entry | undefined = currentIdx > 0 ? allEntries[currentIdx - 1] : undefined;
const nextEntry: Entry | undefined = currentIdx >= 0 && currentIdx < allEntries.length - 1 ? allEntries[currentIdx + 1] : undefined;

// SEO derivation — per-page metadata pulled from the entry, with the OG
// image falling back to the originating plugin's banner_image when the
// entry came from a plugin submodule.
const pageTitle = entry.data.title ?? entry.id;
const pageDescription =
  entry.data.lede ?? entry.data.summary ?? entry.data.description ??
  `Ship note from ${entry.data.from ?? 'content-farm'}.`;
const pluginOg = await getPluginOgImage(entry.data.from);
const publishedTime = (entry.data.date_first_published ?? entry.data.date_created ?? entry.data.date)?.toISOString();
const modifiedTime = (entry.data.date_modified ?? entry.data.date_created ?? entry.data.date)?.toISOString();
const articleAuthor = entry.data.authors?.[0];
const articleTags = entry.data.tags;
---

<BaseLayout
  title={pageTitle}
  description={pageDescription}
  ogImage={pluginOg}
  ogType="article"
  publishedTime={publishedTime}
  modifiedTime={modifiedTime}
  author={articleAuthor}
  tags={articleTags}
>
  <main class="container reading">
    <article>
      <header class="reading-head">
        <div class="reading-meta">
          {entry.data.from && entry.data.from !== 'content-farm' && (
            <span class="from-tag">{entry.data.from}</span>
          )}
          {date && (
            <time class="mono" datetime={new Date(date).toISOString()}>
              {new Date(date).toISOString().slice(0, 10)}
            </time>
          )}
          {entry.data.at_semantic_version && (
            <span class="pill">{entry.data.at_semantic_version}</span>
          )}
          {entry.data.status && <span class="pill" data-status={entry.data.status}>{entry.data.status}</span>}
          {entry.data.legacy && (
            <span class="pill mono" title="From a legacy context-v/changelogs/ path">legacy</span>
          )}
        </div>
        <h1>{entry.data.title ?? entry.id}</h1>
        {entry.data.lede && <p class="reading-lede">{entry.data.lede}</p>}
      </header>

      <MarkdownReader tree={tree} citations={citations} backHref={`${base}changelog`} backLabelTxt="All ship notes" />
    </article>

    <nav class="entry-nav" aria-label="Adjacent ship notes">
      {prevEntry ? (
        <a class="entry-nav__slot entry-nav__slot--prev" href={`${base}changelog/${prevEntry.id}`}>
          <span class="entry-nav__direction">← Newer</span>
          <span class="entry-nav__title">{prevEntry.data.title ?? prevEntry.id}</span>
          {(prevEntry.data.date_modified ?? prevEntry.data.date_created ?? prevEntry.data.date) && (
            <span class="entry-nav__date mono">
              {new Date(prevEntry.data.date_modified ?? prevEntry.data.date_created ?? prevEntry.data.date ?? 0).toISOString().slice(0, 10)}
            </span>
          )}
        </a>
      ) : (
        <span class="entry-nav__slot entry-nav__slot--disabled">
          <span class="entry-nav__direction">← Newer</span>
          <span class="entry-nav__title entry-nav__title--dim">You're at the latest</span>
        </span>
      )}

      <a class="entry-nav__back" href={`${base}changelog`}>
        <span class="entry-nav__back-icon" aria-hidden="true">↩</span>
        <span>Back to all ship notes</span>
      </a>

      {nextEntry ? (
        <a class="entry-nav__slot entry-nav__slot--next" href={`${base}changelog/${nextEntry.id}`}>
          <span class="entry-nav__direction">Older →</span>
          <span class="entry-nav__title">{nextEntry.data.title ?? nextEntry.id}</span>
          {(nextEntry.data.date_modified ?? nextEntry.data.date_created ?? nextEntry.data.date) && (
            <span class="entry-nav__date mono">
              {new Date(nextEntry.data.date_modified ?? nextEntry.data.date_created ?? nextEntry.data.date ?? 0).toISOString().slice(0, 10)}
            </span>
          )}
        </a>
      ) : (
        <span class="entry-nav__slot entry-nav__slot--disabled">
          <span class="entry-nav__direction">Older →</span>
          <span class="entry-nav__title entry-nav__title--dim">You're at the earliest</span>
        </span>
      )}
    </nav>
  </main>
</BaseLayout>

<style>
  .reading {
    padding: clamp(3rem, 8vh, 6rem) 0 var(--space-16);
  }
  .reading-back {
    font-family: var(--ff-mono);
    font-size: 0.875rem;
    margin-bottom: var(--space-8);
  }
  .reading-head {
    max-width: 70ch;
    margin: 0 auto var(--space-12);
  }
  .reading-meta {
    display: flex;
    gap: var(--space-3);
    align-items: center;
    color: var(--clr-text-dim);
    font-size: 0.85rem;
    margin-bottom: var(--space-4);
  }
  .reading-head h1 {
    font-size: clamp(2rem, 4.5vw, 3.25rem);
    line-height: 1.1;
  }
  .reading-lede {
    margin-top: var(--space-4);
    color: var(--clr-text-soft);
    font-size: 1.15rem;
    line-height: 1.5;
  }

  /* Bottom prev / back / next nav. Three-slot grid sized to the same 70ch
     reading column so the buttons line up with the body content above.
     prev and next get the role-clarifying title + date; back-to-list sits
     in the middle as a quieter pill. Disabled slots (at the boundaries of
     the changelog) render dimmed so the layout doesn't reflow. */
  .entry-nav {
    max-width: 70ch;
    margin: var(--space-12) auto var(--space-8);
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    gap: var(--space-3);
    align-items: stretch;
  }
  .entry-nav__slot {
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
    padding: var(--space-4) var(--space-5);
    border-radius: var(--radius-md);
    border: 1px solid var(--clr-border);
    background: var(--clr-bg-card);
    color: var(--clr-text);
    text-decoration: none;
    transition: border-color 180ms ease, transform 180ms ease;
    min-width: 0;
  }
  .entry-nav__slot:hover {
    border-color: var(--clr-border-accent);
    transform: translateY(-2px);
    color: var(--clr-text);
  }
  .entry-nav__slot--next {
    text-align: right;
  }
  .entry-nav__slot--disabled {
    opacity: 0.4;
    cursor: default;
  }
  .entry-nav__slot--disabled:hover {
    border-color: var(--clr-border);
    transform: none;
  }
  .entry-nav__direction {
    font-family: var(--ff-mono);
    font-size: 0.75rem;
    color: var(--clr-text-dim);
    letter-spacing: 0.04em;
  }
  .entry-nav__title {
    font-size: 0.95rem;
    line-height: 1.35;
    color: var(--clr-text);
    /* Don't let very-long titles blow out the column width — clamp to
       two lines with ellipsis so the three slots stay proportional. */
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  .entry-nav__title--dim { color: var(--clr-text-dim); }
  .entry-nav__date {
    color: var(--clr-text-dim);
    font-size: 0.78rem;
  }
  .entry-nav__back {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    padding: var(--space-4) var(--space-5);
    border-radius: var(--radius-md);
    border: 1px solid var(--clr-border);
    background: var(--clr-bg-soft);
    color: var(--clr-text-soft);
    text-decoration: none;
    font-family: var(--ff-mono);
    font-size: 0.85rem;
    transition: color 180ms ease, border-color 180ms ease, background 180ms ease;
    white-space: nowrap;
  }
  .entry-nav__back:hover {
    color: var(--clr-cyan);
    border-color: var(--clr-border-accent);
    background: var(--clr-bg-card);
  }
  .entry-nav__back-icon { font-size: 1rem; }

  @media (max-width: 640px) {
    .entry-nav {
      grid-template-columns: 1fr;
    }
    .entry-nav__slot--next {
      text-align: left;
    }
    .entry-nav__back {
      justify-content: center;
    }
  }
</style>
