---
// Dedicated landing page for Perplexed.
//
// Distinct from `/plugins/perplexed/` (the plugin-card detail surfaced from
// the gallery). This is the standalone destination URL — `/perplexed/` —
// for "tell me about Perplexed" inbound traffic. It draws from the plugin
// repo's README and `docs/directory-templates.md` to give a fuller picture:
// what it does, the directory-template paradigm, model surfaces, streaming
// pipeline, network use, install. Designed to be the canonical share URL
// when someone is sending the project around.
//
// Semantic tokens only (BaseLayout's `:root`). No hard-coded colors.

import { getCollection, getEntry } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';

const base = import.meta.env.BASE_URL;
const plugin = await getEntry('plugin-highlights', 'perplexed');

const banner = typeof plugin?.data.banner_image === 'string' ? plugin.data.banner_image : undefined;
const title = plugin?.data.title ?? 'perplexed';
const lede = plugin?.data.lede;
const repo = plugin?.data.repo ?? 'https://github.com/lossless-group/perplexed-plugin';
const status = plugin?.data.status;
const tags = plugin?.data.tags ?? ['Search', 'AI', 'Directory templates'];

// Recent ship notes from this plugin. Tolerate the empty case — the
// changelog collection may not have any perplexed entries yet.
let pluginChangelog: Awaited<ReturnType<typeof getCollection<'changelog'>>> = [];
try {
  pluginChangelog = (await getCollection('changelog'))
    .filter((e) => e.data.from === 'perplexed' && e.data.publish !== false)
    .sort((a, b) => {
      const da = a.data.date_modified ?? a.data.date_created ?? a.data.date ?? new Date(0);
      const db = b.data.date_modified ?? b.data.date_created ?? b.data.date ?? new Date(0);
      return new Date(db).getTime() - new Date(da).getTime();
    })
    .slice(0, 3);
} catch {
  pluginChangelog = [];
}

// What you can do — the six headline capabilities. Each is described as a
// command-palette interaction with the actual `name:` strings used in
// addCommand() so the marketing matches what the user sees in Cmd-P.
const cores = [
  {
    name: 'Directory templates',
    eyebrow: 'The headline paradigm',
    lede: "Fill empty profile files with researched content. One template per directory describes the entry shape; the plugin applies it across one file or a whole folder, streams responses to disk, and stamps run metadata to frontmatter.",
    accent: 'cyan',
    commands: [
      'Apply directory template to current file',
      'Apply directory template to all files in folder',
      'Stop directory template batch',
    ],
    bullets: [
      'Streams to the file as Perplexity returns chunks — failures surface in seconds, not minutes.',
      '[IMAGE N: …] markers swap to real embeds; fallback # Images section if the model misses.',
      '# Sources footer in the canonical [N]: [Title](URL) form that cite-wide accepts.',
      'cf_last_run + cf_last_run_model stamped to frontmatter so you can query for staleness.',
    ],
  },
  {
    name: 'One-page article',
    eyebrow: 'Quick research',
    lede: 'Type a term, get a researched article streaming into the active note. Pick a model, set a recency window, toggle what comes back.',
    accent: 'magenta',
    commands: ['Generate one-page article'],
    bullets: [
      'Five-model picker: sonar-deep-research, sonar-pro, sonar-small, plus two Llama-3.1-Sonar-online sizes.',
      'Recency filter (day / week / month / year) for fresh-only sources.',
      'Per-run toggles: citations, images, related questions, streaming.',
      'Two editable article templates — one for sonar-pro, one for sonar-deep-research.',
    ],
  },
  {
    name: 'Enhance selected text',
    eyebrow: 'Rewrite with live context',
    lede: 'Highlight prose, run the command, get a streaming rewrite that blends your selection with live web research. Citations woven inline, not appended as a footer.',
    accent: 'aqua',
    commands: ['Enhance selected text with Perplexity'],
    bullets: [
      'Streams into the active note at the cursor — your selection becomes the rewrite seed.',
      'Pre-filled prompt template is editable per-invocation and globally in settings.',
      'sonar-pro by default; citations attached inline tied 1:1 to Perplexity search results.',
    ],
  },
  {
    name: 'Get related images',
    eyebrow: 'Image markers in-stream',
    lede: 'Selected text in, Perplexity image search out — streamed as image markers into the active note at the cursor. Use it when you want visuals to land alongside the existing prose.',
    accent: 'violet',
    commands: ['Get related images for selected text'],
    bullets: [
      'Built on Perplexity sonar-pro with return_images=true.',
      'Image-references prompt is fully editable in settings.',
      'Pairs naturally with Enhance selected text for a research-plus-visuals pass.',
    ],
  },
  {
    name: 'Find images for passage',
    eyebrow: 'On-domain screenshots',
    lede: "Highlight a passage, ask Perplexity for screenshots that visually illustrate it. Restricted to the entity's domain (frontmatter url) — no third-party stock imagery sneaking in.",
    accent: 'cyan',
    commands: ['Find images for selection'],
    bullets: [
      'Splits selection into numbered paragraphs, distributes images across paragraph boundaries.',
      'Strict client-side rejection of off-domain images — better to surface "none found" than to insert noise.',
      'Configurable max-images setting; falls back to even distribution if the model emits no placement markers.',
    ],
  },
  {
    name: 'Ask any model',
    eyebrow: 'Direct queries',
    lede: 'A Cmd-P entry per provider for ad-hoc questions that don\'t need a template or a selection. Each modal exposes the controls that provider actually has.',
    accent: 'magenta',
    commands: [
      'Ask Perplexity',
      'Ask Claude',
      'Ask Perplexica / Vane',
      'Ask LM Studio',
    ],
    bullets: [
      'Each provider modal carries its own knobs — see the Provider depth section below.',
      'Service-status commands per provider for quick connectivity checks.',
      'Update-URL commands for endpoint hot-swaps without touching settings.',
    ],
  },
] as const;

// The four shipped templates that get auto-deployed to the user's vault on
// first plugin load. Listed here for at-a-glance discovery.
const templates = [
  {
    file: 'concept-profile.md',
    targets: 'concepts/**',
    use: 'Encyclopedia-style entries on ideas, patterns, mental models. Anti-incumbent editorial stance baked in.',
    accent: 'cyan',
  },
  {
    file: 'vocabulary-profile.md',
    targets: 'Vocabulary/**',
    use: 'Term definitions with disambiguation through an innovation-consulting lens.',
    accent: 'aqua',
  },
  {
    file: 'source-profile.md',
    targets: 'Sources/**',
    use: 'Profiles of trusted sources — books, people, channels, publications, journals, reports, events. Type-aware.',
    accent: 'magenta',
  },
  {
    file: 'toolkit-profile.md',
    targets: 'Tooling/**',
    use: 'Profiles of tools, products, platforms, frameworks.',
    accent: 'violet',
  },
] as const;

// Per-provider depth — what's actually in each modal. The marketing
// differentiator: every provider modal exposes the controls that
// provider *actually* has, not a lowest-common-denominator UI.
const surfaces = [
  {
    name: 'Perplexity',
    role: 'Search-augmented research',
    command: 'Ask Perplexity',
    endpoint: 'api.perplexity.ai',
    auth: 'API key (paid)',
    locality: 'Hosted',
    accent: 'cyan',
    controls: [
      'Model picker — sonar-deep-research, sonar-pro, sonar-small, llama-3.1-sonar-small-online, llama-3.1-sonar-large-online',
      'Recency filter — day / week / month / year',
      'Live model description that updates as you switch',
      'Service-status command for connectivity check',
    ],
  },
  {
    name: 'Claude',
    role: 'Direct Anthropic API',
    command: 'Ask Claude',
    endpoint: 'api.anthropic.com',
    auth: 'API key (paid)',
    locality: 'Hosted',
    accent: 'magenta',
    controls: [
      'Model picker with live model description',
      'Effort dropdown — controls thinking depth and total token spend',
      'Enable web search — server-side web_search_20250305 with per-claim citations attached to text blocks',
      'Adaptive thinking — Claude reasons before answering on complex prompts',
      'Stream response toggle — recommended for long answers',
    ],
  },
  {
    name: 'Perplexica / Vane',
    role: 'Self-hosted, search-augmented',
    command: 'Ask Perplexica / Vane',
    endpoint: 'localhost:3030 (default, configurable)',
    auth: 'None — runs locally',
    locality: 'Local',
    accent: 'aqua',
    controls: [
      'Focus modes — Web Search, Academic, Writing Assistant, Wolfram Alpha, YouTube, Reddit',
      'Optimization modes — Speed, Balanced, Quality (sources × synthesis depth tradeoff)',
      'Live tagline beneath each picker explains what the mode actually does',
      'No API key required — runs on your machine via Perplexica',
    ],
  },
  {
    name: 'LM Studio',
    role: 'Whatever you have loaded locally',
    command: 'Ask LM Studio',
    endpoint: 'localhost:1234 (default, configurable)',
    auth: 'None — runs locally',
    locality: 'Local',
    accent: 'violet',
    controls: [
      'Bundled-model presets — Phi-4 Reasoning Plus, Gemma 3 12B, Llama 3.2 3B Instruct',
      'Custom-model option — LM Studio routes to whichever model is loaded',
      'Per-model tagline in the picker',
      'Editable default system prompt in plugin settings',
    ],
  },
] as const;

// The customization story — everything user-facing is editable in settings.
// This is a real differentiator that's easy to under-sell.
const customisations = [
  {
    name: 'System prompts (per provider)',
    desc: 'Edit the system prompt for Perplexity, Perplexica / Vane, and LM Studio individually — your editorial voice, not the plugin defaults.',
  },
  {
    name: 'Article generator templates',
    desc: 'Two editable templates: one for sonar-pro requests, one for sonar-deep-research. {TERM} is the interpolation token.',
  },
  {
    name: 'Image references prompt',
    desc: 'The prompt that gets appended whenever a request asks for return_images. Tune it to favor screenshots vs. diagrams vs. photographs.',
  },
  {
    name: 'Text enhancement prompt',
    desc: 'The prompt template used when you enhance a selection. {TEXT} interpolates your highlighted prose.',
  },
  {
    name: 'Placeholder text',
    desc: 'Customize every input placeholder across the modals — small, but it makes the plugin feel like yours.',
  },
  {
    name: 'Reset to defaults',
    desc: 'A "Reset prompts to default" command in the palette puts everything back if you wander too far.',
  },
];

// The four pipeline stages — what happens between "press enter" and "ship to
// disk". Helps frame why we use raw fetch() (SSE) over Obsidian's requestUrl.
const pipeline = [
  {
    step: '01',
    name: 'Stream',
    desc: "fetch() SSE connection — Obsidian's requestUrl buffers the whole response, which defeats live writes. Chunks land in the file every ~500ms so failures surface fast.",
  },
  {
    step: '02',
    name: 'Capture',
    desc: "search_results and images arrays captured during the stream from Perplexity's SSE metadata, kept for post-processing.",
  },
  {
    step: '03',
    name: 'Wrap & swap',
    desc: '<think>…</think> blocks wrap to fenced think-output. [IMAGE N: …] markers swap to ![desc](url) using the captured images array. Fallback # Images section if the model misses.',
  },
  {
    step: '04',
    name: 'Footer & stamp',
    desc: 'Sources footer emitted as canonical [N]: [Title](URL) (cite-wide-compatible). cf_last_run, cf_last_run_model, and (for books) google_books_url stamped to target frontmatter.',
  },
];

// The single key project memory that travels with concept / vocabulary /
// source templates. Pulled up because it's a defining editorial choice.
const editorialStance = {
  title: 'Anti-incumbent editorial stance',
  body: 'Tech giants (Microsoft, Google, Amazon, Apple, Meta, Oracle, Salesforce, post-1990s IBM) are adopters/popularizers, not innovators, unless documented heyday-era origination or a research-lab paper supports innovator framing. Origins favor founder, paper, or originating-startup attribution. "Best Real-World Examples" caps big tech at 1–2 of 5–7 entries.',
  rationale: "Every default LLM corpus leans incumbent because that's where the training-data signal is. The template's system prompt corrects for it once, so concept and vocabulary entries don't fight model bias one prompt at a time.",
};

const installSteps = [
  {
    n: '01',
    title: 'Install from the community plugins directory',
    body: 'Once approved, install via Settings → Community plugins → Browse → search "Perplexed". Until then: clone the repo into <vault>/.obsidian/plugins/perplexed/ and run pnpm install && pnpm build.',
  },
  {
    n: '02',
    title: 'Configure at least one model surface',
    body: 'Settings → Perplexed. Drop in a Perplexity or Anthropic API key for hosted, or point at a local Perplexica / LM Studio endpoint. You can use any combination.',
  },
  {
    n: '03',
    title: 'Let the templates seed',
    body: 'On first load, perplexed writes the four shipped templates plus a README to Content-Dev/Templates/ in your vault. Edit them, add your own, or click Re-seed templates anytime to pull in shipped updates without overwriting your edits.',
  },
  {
    n: '04',
    title: 'Apply a template to a folder',
    body: 'Open the command palette, pick "Apply directory template to folder", choose a folder under your templates\' applies-to-paths globs, confirm the file count. Watch chunks land in real time.',
  },
];

const repoDocsBase = `${repo}/blob/main`;
---

<BaseLayout
  title={`${title} — Research-augmented writing inside Obsidian`}
  description={lede ?? 'Perplexed — directory templates and search-augmented enhancement for Obsidian.'}
  ogImage={banner}
  ogType="article"
>
  <main class="perplexed-landing">
    <!-- ─── HERO ─────────────────────────────────────────────────────── -->
    <section class="hero">
      <div class="container">
        <p class="back">
          <a href={base}>← content-farm</a>
        </p>

        <div class="hero-grid">
          <div class="hero-text">
            <div class="hero-meta">
              {status && <span class="pill" data-status={status}>{status}</span>}
              {tags.slice(0, 3).map((t) => <span class="card-tag">{t}</span>)}
            </div>

            <h1 class="hero-title">
              <span class="hero-icon" aria-hidden="true">🔍</span>
              <span class="hero-name">{title}</span>
            </h1>

            <p class="hero-lede">
              <span class="gradient-text">Research-augmented writing</span>
              <span class="hero-lede-soft">across four model surfaces, inside the editor you already use.</span>
            </p>

            <p class="hero-body">
              Twenty-two commands across <strong>Perplexity</strong>, <strong>Anthropic Claude</strong>, <strong>Perplexica / Vane</strong>, and <strong>LM Studio</strong>. Generate cited one-page articles. Enhance selections with live web context. Stream image markers into prose. Find on-domain screenshots for a passage. Fill whole folders of empty profile files from per-directory templates. Every system prompt, every placeholder, every template is editable in settings — your tone, not ours.
            </p>

            <div class="hero-actions">
              <a href={repo} target="_blank" rel="noopener" class="btn btn-primary">View on GitHub →</a>
              <a href={`${repoDocsBase}/docs/directory-templates.md`} target="_blank" rel="noopener" class="btn btn-ghost">Directory templates doc</a>
              <a href={`${base}plugins/perplexed/`} class="btn btn-link">Plugin card</a>
            </div>
          </div>

          {banner && (
            <figure class="hero-banner">
              <img src={banner} alt={`${title} — banner`} loading="eager" decoding="async" />
            </figure>
          )}
        </div>
      </div>
    </section>

    <!-- ─── CMD-P TEASER ─────────────────────────────────────────────── -->
    <section class="palette-section">
      <div class="container">
        <p class="section-eyebrow">What using it feels like</p>
        <div class="palette-window" aria-label="Command palette teaser">
          <div class="palette-bar">
            <span class="palette-prompt">⌘P</span>
            <span class="palette-cursor">apply directory template</span>
          </div>
          <ul class="palette-results">
            <li><span class="palette-key">↵</span><span>Apply directory template to all files in folder</span><em>perplexed</em></li>
            <li><span class="palette-key">↵</span><span>Generate one-page article</span><em>perplexed</em></li>
            <li><span class="palette-key">↵</span><span>Enhance selected text with Perplexity</span><em>perplexed</em></li>
            <li><span class="palette-key">↵</span><span>Get related images for selected text</span><em>perplexed</em></li>
            <li><span class="palette-key">↵</span><span>Find images for selection</span><em>perplexed</em></li>
            <li><span class="palette-key">↵</span><span>Ask Claude</span><em>perplexed</em></li>
            <li><span class="palette-key">↵</span><span>Ask Perplexica / Vane</span><em>perplexed</em></li>
            <li><span class="palette-key">↵</span><span>Ask LM Studio</span><em>perplexed</em></li>
          </ul>
        </div>
      </div>
    </section>

    <!-- ─── THE FOUR CORES ────────────────────────────────────────────── -->
    <section class="cores-section">
      <div class="container">
        <header class="section-head">
          <p class="section-eyebrow">What you can do</p>
          <h2>Six capabilities, one command palette</h2>
          <p class="section-lede">Each capability is one Cmd-P entry away. Streaming responses, inline citations, and frontmatter stamps are baked in across the lot. The full surface is twenty-two commands once you count service-status checks, URL-update commands, and the meta utilities — these six are the ones you'll reach for daily.</p>
        </header>
        <div class="cores-grid">
          {cores.map((c) => (
            <article class={`core core--${c.accent}`}>
              <p class="core-eyebrow">{c.eyebrow}</p>
              <h3>{c.name}</h3>
              <p class="core-lede">{c.lede}</p>
              <ul class="core-commands">
                {c.commands.map((cmd) => (
                  <li>
                    <span class="kbd-block">⌘P</span>
                    <span class="kbd-cmd">{cmd}</span>
                  </li>
                ))}
              </ul>
              <ul class="core-bullets">
                {c.bullets.map((b) => <li>{b}</li>)}
              </ul>
            </article>
          ))}
        </div>
      </div>
    </section>

    <!-- ─── DIRECTORY TEMPLATES DEEP DIVE ────────────────────────────── -->
    <section class="templates-section">
      <div class="container">
        <header class="section-head">
          <p class="section-eyebrow">The paradigm</p>
          <h2>Directory templates</h2>
          <p class="section-lede">
            A working Obsidian vault collects categories of files that share a shape — concepts, vocabulary, sources, tooling profiles. Filling them out one editor-callback at a time is untenable when you have hundreds or thousands. A directory template binds one prompt to a directory via a glob, then the runtime applies it across one file or a whole folder.
          </p>
        </header>

        <!-- Three primitives -->
        <div class="primitives-grid">
          <article class="primitive">
            <p class="primitive-step">01</p>
            <h3>Template</h3>
            <p>A markdown file with frontmatter (<code>applies-to-paths</code> glob), a fenced <code>cft</code> config block (provider, model, return flags, system prompt with <code>{`{{basename}}`}</code> and <code>{`{{frontmatter.tags}}`}</code> tokens), and a heading skeleton that becomes the user prompt.</p>
          </article>
          <article class="primitive">
            <p class="primitive-step">02</p>
            <h3>Commands</h3>
            <p>One command for the active file (glob-matched), one for a folder (with confirmation modal showing file count), and one to halt a running batch. Fill or append depending on whether the target has existing content.</p>
          </article>
          <article class="primitive">
            <p class="primitive-step">03</p>
            <h3>Cleanup pipeline</h3>
            <p>After the stream ends: wrap <code>{`<think>`}</code> blocks, swap <code>[IMAGE N: …]</code> markers for real embeds (with a fallback section), strip unreplaced placeholders, emit the cite-wide-compatible sources footer, and stamp run metadata to frontmatter.</p>
          </article>
        </div>

        <!-- Four shipped templates table -->
        <h3 class="subsection-head">Four templates ship with the plugin</h3>
        <p class="subsection-lede">Auto-seeded into <code>Content-Dev/Templates/</code> on first plugin load. The seeder is conservative — it only writes the README and only writes templates when the folder is fresh, so your edits are never overwritten.</p>

        <div class="templates-table">
          <div class="templates-row templates-row--head">
            <div>File</div>
            <div>Targets</div>
            <div>Use for</div>
          </div>
          {templates.map((t) => (
            <div class={`templates-row templates-row--${t.accent}`}>
              <div class="mono">{t.file}</div>
              <div class="mono muted">{t.targets}</div>
              <div>{t.use}</div>
            </div>
          ))}
        </div>

        <!-- Editorial stance callout -->
        <aside class="callout">
          <p class="callout-eyebrow">Editorial stance, encoded once</p>
          <h4>{editorialStance.title}</h4>
          <p>{editorialStance.body}</p>
          <p class="callout-foot">{editorialStance.rationale}</p>
        </aside>

        <p class="learn-more">
          <a href={`${repoDocsBase}/docs/directory-templates.md`} target="_blank" rel="noopener">
            Read the full directory-templates reference →
          </a>
        </p>
      </div>
    </section>

    <!-- ─── PROVIDER DEPTH ──────────────────────────────────────────── -->
    <section class="surfaces-section">
      <div class="container">
        <header class="section-head">
          <p class="section-eyebrow">Provider depth</p>
          <h2>Each modal carries its own knobs</h2>
          <p class="section-lede">Most "AI for Obsidian" plugins flatten every provider into a single textarea. Perplexed exposes the controls each provider actually offers — focus modes for Perplexica, web search and adaptive thinking for Claude, the model-recency matrix for Perplexity, the local-model presets for LM Studio.</p>
        </header>
        <div class="surfaces-grid">
          {surfaces.map((s) => (
            <article class={`surface surface--${s.accent} surface--${s.locality === 'Local' ? 'local' : 'hosted'}`}>
              <header class="surface-head">
                <h3>{s.name}</h3>
                <span class="surface-pill">{s.locality}</span>
              </header>
              <p class="surface-role">{s.role}</p>
              <dl class="surface-meta">
                <div>
                  <dt>Command</dt>
                  <dd class="mono">{s.command}</dd>
                </div>
                <div>
                  <dt>Endpoint</dt>
                  <dd class="mono muted">{s.endpoint}</dd>
                </div>
                <div>
                  <dt>Auth</dt>
                  <dd>{s.auth}</dd>
                </div>
              </dl>
              <ul class="surface-controls">
                {s.controls.map((c) => <li>{c}</li>)}
              </ul>
            </article>
          ))}
        </div>
      </div>
    </section>

    <!-- ─── CUSTOMIZE EVERYTHING ────────────────────────────────────── -->
    <section class="customize-section">
      <div class="container">
        <header class="section-head">
          <p class="section-eyebrow">Make it yours</p>
          <h2>Every prompt is editable</h2>
          <p class="section-lede">The defaults are reasonable, but they're not <em>you</em>. Every system prompt, every article template, every image-references prompt, every input placeholder — they're all text fields in plugin settings. Reset to defaults whenever you wander too far.</p>
        </header>
        <div class="customize-grid">
          {customisations.map((c) => (
            <article class="customize-card">
              <h3>{c.name}</h3>
              <p>{c.desc}</p>
            </article>
          ))}
        </div>
      </div>
    </section>

    <!-- ─── STREAMING PIPELINE ──────────────────────────────────────── -->
    <section class="pipeline-section">
      <div class="container">
        <header class="section-head">
          <p class="section-eyebrow">What happens between press-enter and on-disk</p>
          <h2>Streaming &amp; cleanup pipeline</h2>
          <p class="section-lede">The reason perplexed reaches for raw <code>fetch()</code> over Obsidian's <code>requestUrl</code>: SSE chunks need to flush as they arrive, not after the whole response buffers.</p>
        </header>
        <ol class="pipeline-list">
          {pipeline.map((p) => (
            <li class="pipeline-item">
              <div class="pipeline-step">{p.step}</div>
              <div class="pipeline-body">
                <h3>{p.name}</h3>
                <p>{p.desc}</p>
              </div>
            </li>
          ))}
        </ol>
      </div>
    </section>

    <!-- ─── NETWORK / PRIVACY ───────────────────────────────────────── -->
    <section class="privacy-section">
      <div class="container">
        <header class="section-head">
          <p class="section-eyebrow">What leaves your vault</p>
          <h2>Network use &amp; privacy</h2>
          <p class="section-lede">Perplexed only contacts remote services when you invoke their commands. No telemetry, no auto-updates, no vault content sent anywhere implicitly. The plugin manifest is <code>isDesktopOnly: true</code>.</p>
        </header>
        <div class="privacy-card">
          <ul class="privacy-list">
            <li><span class="privacy-check">✓</span>Only prompts you submit through a modal — or text you have explicitly selected — leave the editor.</li>
            <li><span class="privacy-check">✓</span>API keys live in plugin settings, scoped to the vault.</li>
            <li><span class="privacy-check">✓</span>Local model surfaces (Perplexica, LM Studio) keep the request on your machine.</li>
            <li><span class="privacy-check">✓</span>Obsidian handles plugin updates through the community directory — the plugin does not self-update.</li>
          </ul>
        </div>
      </div>
    </section>

    <!-- ─── GET STARTED ─────────────────────────────────────────────── -->
    <section class="install-section">
      <div class="container">
        <header class="section-head">
          <p class="section-eyebrow">Get started</p>
          <h2>From zero to first folder run</h2>
        </header>
        <ol class="install-list">
          {installSteps.map((s) => (
            <li class="install-item">
              <span class="install-num">{s.n}</span>
              <div class="install-body">
                <h3>{s.title}</h3>
                <p>{s.body}</p>
              </div>
            </li>
          ))}
        </ol>
      </div>
    </section>

    <!-- ─── CHANGELOG ───────────────────────────────────────────────── -->
    {pluginChangelog.length > 0 && (
      <section class="changelog-section">
        <div class="container">
          <header class="section-head">
            <p class="section-eyebrow">Recent ship notes</p>
            <h2>What's new</h2>
          </header>
          <ul class="changelog-list">
            {pluginChangelog.map((entry) => {
              const date = entry.data.date_modified ?? entry.data.date_created ?? entry.data.date;
              return (
                <li>
                  <a href={`${base}changelog/${entry.id}`}>
                    <div class="changelog-meta">
                      {date && (
                        <time class="mono" datetime={new Date(date).toISOString()}>
                          {new Date(date).toISOString().slice(0, 10)}
                        </time>
                      )}
                      {entry.data.at_semantic_version && (
                        <span class="pill mono">{entry.data.at_semantic_version}</span>
                      )}
                    </div>
                    <h3>{entry.data.title ?? entry.id}</h3>
                    {entry.data.lede && <p>{entry.data.lede}</p>}
                  </a>
                </li>
              );
            })}
          </ul>
          <p class="learn-more">
            <a href={`${base}changelog`}>All ship notes →</a>
          </p>
        </div>
      </section>
    )}

    <!-- ─── FOOT ────────────────────────────────────────────────────── -->
    <section class="foot-section">
      <div class="container">
        <p class="foot-lede">Built where writing happens.</p>
        <div class="foot-links">
          <a href={repo} target="_blank" rel="noopener">GitHub</a>
          <a href={`${repoDocsBase}/README.md`} target="_blank" rel="noopener">README</a>
          <a href={`${repoDocsBase}/docs/directory-templates.md`} target="_blank" rel="noopener">Directory templates</a>
          <a href={`${base}plugins/perplexed/`}>Plugin card</a>
          <a href={base}>All plugins</a>
        </div>
      </div>
    </section>
  </main>
</BaseLayout>

<style>
  .perplexed-landing {
    padding-bottom: var(--space-24);
  }

  /* ─── HERO ─────────────────────────────────────────────────────────── */
  .hero {
    padding: clamp(3rem, 8vh, 6rem) 0 var(--space-16);
  }
  .back {
    font-family: var(--ff-mono);
    font-size: 0.8rem;
    margin-bottom: var(--space-8);
  }
  .back a { color: var(--clr-text-dim); }
  .back a:hover { color: var(--clr-cyan); }

  .hero-grid {
    display: grid;
    grid-template-columns: 1.1fr 1fr;
    gap: var(--space-12);
    align-items: center;
  }
  @media (max-width: 900px) {
    .hero-grid { grid-template-columns: 1fr; gap: var(--space-8); }
  }

  .hero-meta {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    align-items: center;
    margin-bottom: var(--space-6);
  }

  .hero-title {
    font-family: var(--ff-mono);
    font-size: clamp(2.5rem, 6vw, 4rem);
    line-height: 1.05;
    display: flex;
    align-items: center;
    gap: var(--space-4);
    margin-bottom: var(--space-6);
  }
  .hero-icon {
    font-size: 0.9em;
    display: grid;
    place-items: center;
    width: 1.2em;
    height: 1.2em;
    border-radius: var(--radius-md);
    background: rgba(4, 229, 229, 0.06);
    border: 1px solid var(--clr-border-accent);
  }
  .hero-name { letter-spacing: -0.04em; }

  .hero-lede {
    font-size: clamp(1.25rem, 2.5vw, 1.75rem);
    line-height: 1.3;
    margin-bottom: var(--space-6);
  }
  .hero-lede-soft {
    color: var(--clr-text-soft);
    margin-left: 0.4em;
    font-weight: 500;
  }
  .hero-body {
    font-size: 1rem;
    line-height: 1.65;
    color: var(--clr-text-soft);
    max-width: 60ch;
    margin-bottom: var(--space-8);
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
    align-items: center;
  }

  .hero-banner {
    margin: 0;
  }
  .hero-banner img {
    width: 100%;
    height: auto;
    border-radius: var(--radius-lg);
    border: 1px solid var(--clr-border);
    display: block;
    box-shadow: var(--shadow-glow-cyan);
  }

  /* ─── SECTION RHYTHM ──────────────────────────────────────────────── */
  /* Every section in the landing gets the same generous vertical padding,
     so the gap between visually-heavy components (palette window, card
     grids, tables) and the next section's messaging is consistent across
     the page. The previous per-section margin-bottom approach produced
     uneven rhythm where text felt crowded by adjacent illustrations. */
  .perplexed-landing > section {
    padding-block: var(--space-12);
  }
  .perplexed-landing > section.hero {
    padding-block: clamp(3rem, 8vh, 6rem) var(--space-16);
  }
  .perplexed-landing > section.foot-section {
    padding-block: var(--space-16);
  }

  /* ─── SECTION HEADS ──────────────────────────────────────────────── */
  /* Section heads span the full container width — only the lede gets a
     reading-width cap. This stops large h2 phrases like "Six capabilities,
     one command palette" from wrapping mid-phrase at typical viewports. */
  .section-head {
    width: 100%;
    margin-inline: auto;
    margin-bottom: var(--space-12);
    text-align: center;
  }
  .section-eyebrow {
    font-family: var(--ff-mono);
    font-size: 0.75rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--clr-text-dim);
    margin-bottom: var(--space-3);
  }
  .palette-section .section-eyebrow {
    text-align: center;
    margin-bottom: var(--space-6);
  }
  .section-head h2 {
    font-size: clamp(1.875rem, 3.5vw, 2.5rem);
    margin-bottom: var(--space-4);
  }
  .section-head .section-lede {
    color: var(--clr-text-soft);
    font-size: 1rem;
    line-height: 1.65;
    max-width: 65ch;
    margin-inline: auto;
  }
  .subsection-head {
    font-size: 1.4rem;
    margin-block: var(--space-12) var(--space-3);
    margin-inline: auto;
    font-family: var(--ff-mono);
    text-align: center;
    width: 100%;
  }
  .subsection-lede {
    color: var(--clr-text-soft);
    font-size: 0.95rem;
    line-height: 1.6;
    width: 100%;
    max-width: 65ch;
    margin-inline: auto;
    margin-bottom: var(--space-6);
    text-align: center;
  }
  .learn-more {
    margin-top: var(--space-8);
    text-align: center;
    font-family: var(--ff-mono);
    font-size: 0.875rem;
  }

  /* ─── CMD-P TEASER ────────────────────────────────────────────────── */
  .palette-window {
    width: 100%;
    max-width: 760px;
    margin-inline: auto;
    border-radius: var(--radius-lg);
    border: 1px solid var(--clr-border-strong);
    background: var(--clr-bg-elevated);
    overflow: hidden;
    box-shadow: 0 24px 60px rgba(0, 0, 0, 0.45), var(--shadow-glow-cyan);
  }
  .palette-bar {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    padding: var(--space-4) var(--space-5);
    border-bottom: 1px solid var(--clr-border);
    background: rgba(255, 255, 255, 0.02);
  }
  .palette-prompt {
    font-family: var(--ff-mono);
    font-size: 0.8rem;
    padding: 4px 8px;
    border-radius: 6px;
    border: 1px solid var(--clr-border-strong);
    color: var(--clr-text-soft);
  }
  .palette-cursor {
    font-family: var(--ff-mono);
    color: var(--clr-cyan);
    font-size: 0.95rem;
    position: relative;
  }
  .palette-cursor::after {
    content: '';
    display: inline-block;
    width: 8px;
    height: 1em;
    margin-left: 4px;
    background: var(--clr-cyan);
    vertical-align: text-bottom;
    animation: blink 1.1s step-end infinite;
  }
  @keyframes blink { 50% { opacity: 0; } }
  .palette-results {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .palette-results li {
    display: flex;
    align-items: center;
    gap: var(--space-4);
    padding: var(--space-3) var(--space-5);
    font-family: var(--ff-mono);
    font-size: 0.875rem;
    border-bottom: 1px solid var(--clr-border);
    color: var(--clr-text-soft);
  }
  .palette-results li:last-child { border-bottom: 0; }
  .palette-results li:first-child {
    background: rgba(4, 229, 229, 0.06);
    color: var(--clr-text);
  }
  .palette-results li em {
    margin-left: auto;
    font-style: normal;
    font-size: 0.75rem;
    color: var(--clr-text-dim);
  }
  .palette-key {
    width: 18px;
    text-align: center;
    color: var(--clr-text-dim);
  }

  /* ─── CORES GRID ──────────────────────────────────────────────────── */
  .cores-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: var(--space-4);
  }
  @media (max-width: 720px) { .cores-grid { grid-template-columns: 1fr; } }

  .core {
    --accent: var(--clr-cyan);
    padding: var(--space-6);
    border-radius: var(--radius-lg);
    border: 1px solid var(--clr-border);
    background: var(--clr-bg-card);
    transition: border-color 200ms ease, transform 200ms ease;
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
  }
  .core:hover {
    border-color: var(--clr-border-accent);
    transform: translateY(-2px);
  }
  .core--cyan    { --accent: var(--clr-cyan); }
  .core--magenta { --accent: var(--clr-purple); }
  .core--aqua    { --accent: var(--clr-aquamarine); }
  .core--violet  { --accent: var(--clr-violet); }

  .core-eyebrow {
    color: var(--accent);
    text-transform: uppercase;
    letter-spacing: 0.08em;
    font-size: 0.7rem;
    font-family: var(--ff-mono);
  }
  .core h3 {
    font-size: 1.4rem;
    font-family: var(--ff-mono);
  }
  .core-lede {
    color: var(--clr-text-soft);
    font-size: 0.95rem;
    line-height: 1.55;
  }
  .core-commands {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    gap: var(--space-2);
  }
  .core-commands li {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    padding: var(--space-2) var(--space-3);
    border-radius: var(--radius-sm);
    background: rgba(255, 255, 255, 0.02);
    border: 1px solid var(--clr-border);
  }
  .core-bullets {
    margin: 0;
    padding-left: var(--space-5);
    color: var(--clr-text-dim);
    font-size: 0.85rem;
    line-height: 1.5;
    display: grid;
    gap: var(--space-2);
  }

  /* ─── DIRECTORY TEMPLATES DEEP DIVE ──────────────────────────────── */
  .primitives-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--space-6);
    margin-bottom: var(--space-8);
  }
  @media (max-width: 720px) { .primitives-grid { grid-template-columns: 1fr; } }

  .primitive {
    padding: var(--space-6);
    border-radius: var(--radius-lg);
    border: 1px solid var(--clr-border);
    background: var(--clr-bg-card);
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }
  .primitive-step {
    font-family: var(--ff-mono);
    font-size: 0.75rem;
    letter-spacing: 0.16em;
    color: var(--clr-cyan);
  }
  .primitive h3 {
    font-size: 1.2rem;
    font-family: var(--ff-mono);
  }
  .primitive p {
    color: var(--clr-text-soft);
    font-size: 0.9rem;
    line-height: 1.6;
  }
  .primitive code {
    font-family: var(--ff-mono);
    font-size: 0.85em;
    background: rgba(4, 229, 229, 0.08);
    color: var(--clr-cyan);
    padding: 1px 5px;
    border-radius: 4px;
  }

  /* templates table — shares max-width with .callout below so their
     edges align visually in the same section. */
  .templates-table {
    border: 1px solid var(--clr-border);
    border-radius: var(--radius-lg);
    background: var(--clr-bg-card);
    overflow: hidden;
    width: 100%;
    max-width: 920px;
    margin-inline: auto;
  }
  .templates-row {
    display: grid;
    grid-template-columns: 1.2fr 1fr 2fr;
    gap: var(--space-4);
    padding: var(--space-4) var(--space-5);
    border-bottom: 1px solid var(--clr-border);
    font-size: 0.9rem;
    align-items: center;
    position: relative;
  }
  .templates-row:last-child { border-bottom: 0; }
  .templates-row--head {
    background: rgba(255, 255, 255, 0.02);
    color: var(--clr-text-dim);
    font-family: var(--ff-mono);
    font-size: 0.75rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }
  .templates-row .mono {
    font-family: var(--ff-mono);
    font-size: 0.85rem;
  }
  .templates-row .muted { color: var(--clr-text-dim); }
  /* coloured left edge per template accent */
  .templates-row:not(.templates-row--head)::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0;
    bottom: 0;
    width: 3px;
    background: var(--clr-cyan);
  }
  .templates-row--cyan::before    { background: var(--clr-cyan); }
  .templates-row--aqua::before    { background: var(--clr-aquamarine); }
  .templates-row--magenta::before { background: var(--clr-purple); }
  .templates-row--violet::before  { background: var(--clr-violet); }
  @media (max-width: 720px) {
    .templates-row {
      grid-template-columns: 1fr;
      gap: var(--space-2);
    }
  }

  /* editorial-stance callout — width matches .templates-table so edges
     line up. Explicit margin-inline: auto to remove any auto-shorthand
     ambiguity. */
  .callout {
    width: 100%;
    max-width: 920px;
    margin-inline: auto;
    margin-block: var(--space-10) 0;
    padding: var(--space-6);
    border-radius: var(--radius-lg);
    border: 1px solid var(--clr-border-strong);
    background: rgba(191, 35, 247, 0.04);
    border-left: 3px solid var(--clr-purple);
  }
  .callout-eyebrow {
    font-family: var(--ff-mono);
    font-size: 0.7rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--clr-purple);
    margin-bottom: var(--space-3);
  }
  .callout h4 {
    font-size: 1.1rem;
    margin-bottom: var(--space-4);
  }
  .callout p {
    color: var(--clr-text-soft);
    font-size: 0.95rem;
    line-height: 1.6;
    margin-bottom: var(--space-4);
  }
  .callout-foot {
    color: var(--clr-text-dim);
    font-size: 0.85rem;
    font-style: italic;
    margin-bottom: 0;
  }

  /* ─── MODEL SURFACES ─────────────────────────────────────────────── */
  .surfaces-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: var(--space-4);
  }
  @media (max-width: 720px) { .surfaces-grid { grid-template-columns: 1fr; } }

  .surface {
    padding: var(--space-6);
    border-radius: var(--radius-lg);
    border: 1px solid var(--clr-border);
    background: var(--clr-bg-card);
    transition: border-color 200ms ease;
  }
  .surface:hover { border-color: var(--clr-border-strong); }
  .surface-head {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: var(--space-3);
  }
  .surface h3 {
    font-size: 1.25rem;
    font-family: var(--ff-mono);
  }
  .surface-pill {
    font-family: var(--ff-mono);
    font-size: 0.7rem;
    padding: 3px 10px;
    border-radius: 999px;
    border: 1px solid var(--clr-border-strong);
    color: var(--clr-text-soft);
  }
  .surface--local .surface-pill {
    color: var(--clr-aquamarine);
    border-color: rgba(111, 255, 214, 0.4);
    background: rgba(111, 255, 214, 0.08);
  }
  .surface--hosted .surface-pill {
    color: var(--clr-cyan);
    border-color: rgba(4, 229, 229, 0.4);
    background: rgba(4, 229, 229, 0.08);
  }
  .surface-role {
    color: var(--clr-text-soft);
    font-size: 0.9rem;
    margin-bottom: var(--space-5);
  }
  .surface-meta {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-3);
    margin: 0;
  }
  .surface-meta > div {
    padding: var(--space-2) 0;
    border-top: 1px solid var(--clr-border);
  }
  .surface-meta dt {
    font-family: var(--ff-mono);
    font-size: 0.65rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--clr-text-dim);
    margin-bottom: 2px;
  }
  .surface-meta dd {
    margin: 0;
    font-size: 0.85rem;
    color: var(--clr-text);
  }
  .surface-meta dd.muted { color: var(--clr-text-dim); }

  .surface-controls {
    list-style: none;
    margin: var(--space-5) 0 0;
    padding: var(--space-4) 0 0;
    border-top: 1px solid var(--clr-border);
    display: grid;
    gap: var(--space-2);
  }
  .surface-controls li {
    color: var(--clr-text-dim);
    font-size: 0.85rem;
    line-height: 1.55;
    padding-left: var(--space-4);
    position: relative;
  }
  .surface-controls li::before {
    content: '▸';
    position: absolute;
    left: 0;
    top: 1px;
    color: var(--accent, var(--clr-cyan));
    font-size: 0.7rem;
    line-height: 1.6;
  }
  /* Per-provider accent — drives the bullet glyph color */
  .surface--cyan    { --accent: var(--clr-cyan); }
  .surface--magenta { --accent: var(--clr-purple); }
  .surface--aqua    { --accent: var(--clr-aquamarine); }
  .surface--violet  { --accent: var(--clr-violet); }

  /* ─── CUSTOMIZE EVERYTHING ──────────────────────────────────────── */
  .customize-section em {
    color: var(--clr-aquamarine);
    font-style: italic;
  }
  /* 3-col grid gets a larger gap than 2-col grids — cards in a 3-col
     layout sit closer to each neighbor, so the gap needs to compensate. */
  .customize-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--space-6);
    width: 100%;
    max-width: 1100px;
    margin-inline: auto;
  }
  @media (max-width: 900px) { .customize-grid { grid-template-columns: repeat(2, 1fr); } }
  @media (max-width: 540px) { .customize-grid { grid-template-columns: 1fr; } }
  /* Padding and internal gap match the other card primitives on this
     page (.core, .primitive, .surface) — keeps the rhythm consistent. */
  .customize-card {
    padding: var(--space-6);
    border-radius: var(--radius-md);
    border: 1px solid var(--clr-border);
    background: var(--clr-bg-card);
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
    transition: border-color 200ms ease, transform 200ms ease;
  }
  .customize-card:hover {
    border-color: var(--clr-border-accent);
    transform: translateY(-2px);
  }
  .customize-card h3 {
    font-size: 1.05rem;
    font-family: var(--ff-mono);
    color: var(--clr-aquamarine);
  }
  .customize-card p {
    color: var(--clr-text-soft);
    font-size: 0.9rem;
    line-height: 1.6;
  }

  /* ─── PIPELINE ───────────────────────────────────────────────────── */
  .pipeline-list {
    list-style: none;
    padding: 0;
    width: 100%;
    max-width: 820px;
    margin-block: 0;
    margin-inline: auto;
    display: grid;
    gap: var(--space-3);
  }
  .pipeline-item {
    display: grid;
    grid-template-columns: 80px 1fr;
    gap: var(--space-4);
    padding: var(--space-6);
    border-radius: var(--radius-lg);
    border: 1px solid var(--clr-border);
    background: var(--clr-bg-card);
    align-items: start;
  }
  @media (max-width: 540px) {
    .pipeline-item { grid-template-columns: 1fr; gap: var(--space-2); }
  }
  .pipeline-step {
    font-family: var(--ff-mono);
    font-size: 2rem;
    color: var(--clr-cyan);
    line-height: 1;
  }
  .pipeline-body h3 {
    font-size: 1.1rem;
    font-family: var(--ff-mono);
    margin-bottom: var(--space-2);
  }
  .pipeline-body p {
    color: var(--clr-text-soft);
    font-size: 0.9rem;
    line-height: 1.6;
  }
