---
import MetaTags from '../components/basics/MetaTags.astro';
import Analytics from '../components/Analytics.astro';
import { STATIC_SEO } from '../lib/seo';

interface Props {
  /** Bare title — the suffix is appended automatically by MetaTags. */
  title: string;
  /** Meta description / og:description / twitter:description. */
  description?: string;
  /** Override the default OG image. Path under /public or absolute URL. */
  ogImage?: string;
  ogImageWidth?: number;
  ogImageHeight?: number;
  ogImageType?: string;
  ogImageAlt?: string;
  /** "website" (default), "article", etc. */
  ogType?: string;
  /** Defaults to false (public splash). */
  noindex?: boolean;
  /** Override the canonical URL. */
  canonical?: string;
  /** Article-only metadata. */
  publishedTime?: string;
  modifiedTime?: string;
  author?: string;
  tags?: string[];
}

const {
  title,
  description = STATIC_SEO.root.description,
  ogImage,
  ogImageWidth,
  ogImageHeight,
  ogImageType,
  ogImageAlt,
  ogType,
  noindex,
  canonical,
  publishedTime,
  modifiedTime,
  author,
  tags,
} = Astro.props;

const base = import.meta.env.BASE_URL;
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <MetaTags
      title={title}
      description={description}
      ogImage={ogImage}
      ogImageWidth={ogImageWidth}
      ogImageHeight={ogImageHeight}
      ogImageType={ogImageType}
      ogImageAlt={ogImageAlt}
      ogType={ogType}
      noindex={noindex}
      canonical={canonical}
      publishedTime={publishedTime}
      modifiedTime={modifiedTime}
      author={author}
      tags={tags}
    />
    <link rel="icon" type="image/svg+xml" href={`${base}favicon.svg`} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=JetBrains+Mono:wght@400;500;600&display=swap"
      rel="stylesheet"
    />
    <Analytics />
  </head>
  <body>
    <div class="bg-mesh" aria-hidden="true"></div>
    <slot />
  </body>
</html>

<style is:global>
  :root {
    /* Surfaces */
    --clr-bg: #0a0a0f;
    --clr-bg-soft: #11111a;
    --clr-bg-elevated: #161623;
    --clr-bg-card: rgba(22, 22, 35, 0.65);

    /* Lossless brand */
    --clr-cyan: #04e5e5;
    --clr-aquamarine: #6fffd6;
    --clr-purple: #bf23f7;
    --clr-violet: #7c5cff;

    /* Type */
    --clr-text: #f1f5f9;
    --clr-text-soft: #cbd5e1;
    --clr-text-dim: #94a3b8;
    --clr-text-dimmer: #64748b;

    /* Borders */
    --clr-border: rgba(255, 255, 255, 0.08);
    --clr-border-strong: rgba(255, 255, 255, 0.16);
    --clr-border-accent: rgba(4, 229, 229, 0.35);

    --ff-sans: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
    --ff-mono: 'JetBrains Mono', ui-monospace, SFMono-Regular, Menlo, monospace;

    --radius-sm: 6px;
    --radius-md: 12px;
    --radius-lg: 18px;
    --radius-xl: 28px;

    --space-1: 0.25rem;
    --space-2: 0.5rem;
    --space-3: 0.75rem;
    --space-4: 1rem;
    --space-6: 1.5rem;
    --space-8: 2rem;
    --space-12: 3rem;
    --space-16: 4rem;
    --space-24: 6rem;

    --shadow-glow-cyan: 0 0 40px rgba(4, 229, 229, 0.18);
    --shadow-glow-purple: 0 0 50px rgba(191, 35, 247, 0.18);
  }

  *,
  *::before,
  *::after {
    box-sizing: border-box;
  }

  html {
    background: var(--clr-bg);
    color-scheme: dark;
  }

  body {
    margin: 0;
    min-height: 100vh;
    background: var(--clr-bg);
    color: var(--clr-text);
    font-family: var(--ff-sans);
    font-size: 16px;
    line-height: 1.55;
    -webkit-font-smoothing: antialiased;
    overflow-x: hidden;
    position: relative;
  }

  /* Subtle mesh background — fixed, behind everything */
  .bg-mesh {
    position: fixed;
    inset: 0;
    z-index: 0;
    pointer-events: none;
    background:
      radial-gradient(
        circle at 15% 12%,
        rgba(4, 229, 229, 0.12),
        transparent 45%
      ),
      radial-gradient(
        circle at 85% 8%,
        rgba(191, 35, 247, 0.1),
        transparent 50%
      ),
      radial-gradient(
        circle at 50% 95%,
        rgba(111, 255, 214, 0.08),
        transparent 55%
      );
  }

  /* Faint grid overlay — agricultural rows + tech */
  .bg-mesh::after {
    content: '';
    position: absolute;
    inset: 0;
    background-image:
      linear-gradient(to right, rgba(255, 255, 255, 0.02) 1px, transparent 1px),
      linear-gradient(to bottom, rgba(255, 255, 255, 0.02) 1px, transparent 1px);
    background-size: 64px 64px;
    mask-image: radial-gradient(ellipse at top, black 0%, transparent 70%);
    -webkit-mask-image: radial-gradient(ellipse at top, black 0%, transparent 70%);
  }

  body > :not(.bg-mesh) {
    position: relative;
    z-index: 1;
  }

  h1,
  h2,
  h3,
  h4,
  h5 {
    margin: 0;
    line-height: 1.15;
    letter-spacing: -0.02em;
    font-weight: 700;
  }

  p {
    margin: 0;
  }

  a {
    color: var(--clr-cyan);
    text-decoration: none;
    transition: color 160ms ease;
  }
  a:hover {
    color: var(--clr-aquamarine);
  }
  a:focus-visible {
    outline: 2px solid var(--clr-cyan);
    outline-offset: 3px;
    border-radius: 4px;
  }

  ::selection {
    background: rgba(4, 229, 229, 0.3);
    color: var(--clr-text);
  }

  .container {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 var(--space-6);
  }

  .mono {
    font-family: var(--ff-mono);
  }

  .eyebrow {
    font-family: var(--ff-mono);
    font-size: 0.75rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--clr-text-dim);
  }

  .gradient-text {
    background: linear-gradient(
      120deg,
      var(--clr-cyan) 0%,
      var(--clr-aquamarine) 50%,
      var(--clr-purple) 100%
    );
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }

  .pill {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    padding: 4px 10px;
    border-radius: 999px;
    font-family: var(--ff-mono);
    font-size: 0.7rem;
    letter-spacing: 0.06em;
    border: 1px solid var(--clr-border-strong);
    color: var(--clr-text-soft);
    background: rgba(255, 255, 255, 0.03);
  }
  .pill[data-status='Stable'] {
    color: var(--clr-aquamarine);
    border-color: rgba(111, 255, 214, 0.4);
    background: rgba(111, 255, 214, 0.08);
  }
  .pill[data-status='Beta'] {
    color: var(--clr-cyan);
    border-color: rgba(4, 229, 229, 0.4);
    background: rgba(4, 229, 229, 0.08);
  }
  .pill[data-status='Alpha'] {
    color: var(--clr-purple);
    border-color: rgba(191, 35, 247, 0.45);
    background: rgba(191, 35, 247, 0.08);
  }
  .pill[data-status='Experiment'] {
    color: var(--clr-violet);
    border-color: rgba(124, 92, 255, 0.45);
    background: rgba(124, 92, 255, 0.08);
  }

  .from-tag {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    padding: 2px 8px;
    border-radius: 4px;
    font-family: var(--ff-mono);
    font-size: 0.7rem;
    letter-spacing: 0.04em;
    color: var(--clr-aquamarine);
    background: rgba(111, 255, 214, 0.08);
    border: 1px solid rgba(111, 255, 214, 0.25);
  }
  .from-tag::before {
    content: '◆';
    font-size: 0.6rem;
    opacity: 0.8;
  }
</style>
